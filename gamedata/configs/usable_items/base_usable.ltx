; gwr animated item-use -- base WP_BINOC item + hud base (Clear Sky / IX-Ray).
; Reuses the IX-Ray-proven WP_BINOC boilerplate and adds the gwr_eatable binder.

[gwr_base_usable_hud]
zoom_hide_crosshair						= true
attach_place_idx						= 0
hands_position							= 0.0,-0.02,0.14
hands_orientation						= 0.0,0.0,0.0
hands_position_16x9						= 0.0,-0.02,0.14
hands_orientation_16x9					= 0.0,0.0,0.0
item_position    						= 0.0,0.0,0.0
item_orientation   						= 0.0,0.0,0.0
aim_hud_offset_pos						= 0.0,0.0,0.0
aim_hud_offset_rot						= 0.0,0.0,0.0
aim_hud_offset_pos_16x9					= 0.0,0.0,0.0
aim_hud_offset_rot_16x9					= 0.0,0.0,0.0
gl_hud_offset_pos						= 0,0,0
gl_hud_offset_rot						= 0,0,0
gl_hud_offset_pos_16x9					= 0,0,0
gl_hud_offset_rot_16x9					= 0,0,0
lean_hud_offset_pos						= 0,0,0
lean_hud_offset_rot						= 0,0,0
; DOF while the item is being brought up, straight from Gunslinger usable_items/base_usable.ltx.
; The engine reads these per alias out of the hud section (CHudItem::StartActionDof), so nothing
; but the keys is needed. Released 0.6 s BEFORE anm_show ends, so focus is back by the time the
; item reaches the mouth.
use_dof_anm_show                        = true
dof_anm_show_focus                      = 0.3
dof_anm_show_far                        = 3
dof_speed_in_anm_show                   = 2
dof_time_offset_anm_show                = -0.6
[gwr_identity_immunities]
burn_immunity							= 1.0
strike_immunity							= 1.0
shock_immunity							= 1.0
wound_immunity							= 1.0
wound_2_immunity						= 1.0
radiation_immunity						= 1.0
telepatic_immunity						= 1.0
chemical_burn_immunity					= 1.0
explosion_immunity						= 1.0
fire_wound_immunity						= 1.0

; Gunslinger trash: the wrapper/bottle/blister the animation throws away, spawned by the item's own
; hud binder at `timing_trash` and pushed by gwr_eatable's trash binder. A plain physics object that
; deletes itself after `remove_time`, so the world never fills up with litter.
; class is O_PHYSIC, NOT GS's O_PHYS_S -- our factory only registers the former
; (object_factory_register.cpp: CLSID_OBJECT_PHYSIC); everything else is GS verbatim.
[gwr_base_trash]
GroupControlSection = spawn_group
$spawn              = "physics\object"
$prefetch           = 8
class               = O_PHYSIC
remove_time         = 90        ; seconds the piece lies around before it is released
startup_animation   =
fixed_bones         =
script_binding      = gwr_eatable.init_trash
; GS throws no dust when the wrapper lands; our physics does, because a skeleton physic object
; masses 10 kg by default and even a short drop clears the collide-effect threshold. This keeps
; the clatter and the floor mark, and drops only the particles (CPhysicObject::CreatePhysicsShell).
no_collide_particles = true

