; The empty water bottle. Dropped only by the LAST sip (water_hud_model4) -- the earlier stages put
; a partly-drunk bottle back in the bag instead. GS's own values.
[water_trash]:gwr_base_trash
visual              = gwr\food\water\water_trash.ogf
throw_dir           = left
throw_impulse_z     = 60

; The empty can. Unlike every other piece of trash this one is NOT thrown: it is dropped at the
; actor's feet (offset straight down from the camera, a nudge forward so it does not spawn inside
; him) with only enough impulse to make it settle.
[conserva_trash]:gwr_base_trash
visual              = gwr\food\conserva\conserva_trash.ogf
throw_dir           = left		; orig forward
throw_offset_x      = 0.35
throw_offset_y      = -0.2	; orig -1.35 -- leaves the hand now, not the knees
throw_offset_z      = -0.55	; along cam_right, negative = LEFT. Far enough to spawn OFF SCREEN: at
							; throw_offset_x = 0.35 m from the camera the half-width of the view is
							; only ~0.23 m, so -0.2 was still inside the frame and the can popped in
							; visibly. Push this further out (or pull offset_x in) if it ever shows.
throw_impulse_y     = 0.35	; orig -0.5 -- this REPLACES dir.y, so positive = slightly up (~19 deg)
throw_impulse_z     = 25	; orig 5 -- a real throw, but softer than the bottles (60/65/75): the
							; can is light and 55 sent it flying. The tumble comes with the throw: a hit
							; lands its impulse at the hit POINT, not through the mass centre, so anything
							; thrown hard enough spins by itself. Too low and it stops turning (5 did).

