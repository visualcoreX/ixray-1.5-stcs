; The hidden object that carries the sip's real effect, eaten by the hud binder after effect_delay.
; thirst_factor is read by gunsl_thirst.OnItemUsed, not by the engine -- everything else is engine-side.
; lsd_factor is read by gunsl_peredoz.script, the medicine-intoxication system.

[water_eatable]:identity_immunities
GroupControlSection = spawn_group
$spawn              = "weapons\water_eatable"
$prefetch           = 8
class               = II_BOTTL
cform               = skeleton
visual              = gwr\main\fake_object
description         = gunsl_eatable_water_descr
inv_name            = gunsl_eatable_water
inv_name_short      = gunsl_eatable_water
inv_weight          = 0.0
cost                = 0
inv_grid_width      = 1
inv_grid_height     = 1
inv_grid_x          = 20
inv_grid_y          = 0

eat_health          = 0
eat_satiety         = -0.01
eat_power           = 0
eat_radiation       = 0
eat_alcohol         = -0.05
wounds_heal_perc    = 0
eat_portions_num    = 1

thirst_factor       = 0.65

; GS medicine intoxication, read by gunsl_peredoz.script (GS water -- negative, i.e.
; the one thing on this list that flushes it out). A flat 0.6: one bottle always takes the
; same amount off, and the level itself has no ceiling.
lsd_factor          = -0.6
