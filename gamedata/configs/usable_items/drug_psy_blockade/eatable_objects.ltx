; The hidden phantom that carries the real effect, eaten by the hud model's binder after
; effect_delay (gwr_eatable_object). GS's key here is the CoP booster boost_telepat_protection;
; ours is psi_blockade_time, read by CEatableItem::UseBy -> CActor::StartPsiBlockade.
; While the timer runs: telepathic damage is halved (psi_blockade_protection in gunslinger_params)
; and a controller cannot take hold at all (CActor::IsPsiBlocked), same as being drunk.

[drug_psy_blockade_eatable]:identity_immunities
GroupControlSection = spawn_group
$spawn              = "weapons\drug_psy_blockade_eatable"
$prefetch           = 8
; II_ANTIR for the same reason as the real item: this phantom sits in the inventory until
; effect_delay elapses, and an II_MEDKI there would be picked up by the medkit hotkey.
class               = II_ANTIR
cform               = skeleton
visual              = gwr\main\fake_object
description         = gunsl_eatable_psy_blockade_descr
inv_name            = gunsl_eatable_psy_blockade
inv_name_short      = gunsl_eatable_psy_blockade
inv_weight          = 0.0
cost                = 0
inv_grid_width      = 1
inv_grid_height     = 1
inv_grid_x          = 20
inv_grid_y          = 0

eat_health          = 0
eat_satiety         = 0
eat_power           = 0
eat_radiation       = 0
wounds_heal_perc    = 0
eat_portions_num    = 1

psi_blockade_time   = 180   ; seconds of psi protection (3 minutes)

; GS medicine intoxication, read by gunsl_peredoz.script (GS drug_psy_blockade -- the heaviest single dose of anything you can carry).
; sqprop is proportional to what is already in the blood, mul multiplies it, the flat
; lsd_factor is the dose itself; _master replaces it from veteran up.
lsd_factor          = 0.8
