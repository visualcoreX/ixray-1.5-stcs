; hidden object that carries the medkit's real effect. gwr_eatable spawns and
; eats it after effect_delay, so the healing lands during the animation instead
; of instantly. The real [medkit] in items.ltx has its eat_* values zeroed.

[medkit_eatable]:identity_immunities
GroupControlSection = spawn_group
$spawn              = "weapons\medkit_eatable"
$prefetch           = 8
class               = II_MEDKI
cform               = skeleton
visual              = gwr\main\fake_object
description         = st_medkit_descr
inv_name            = st_medkit
inv_name_short      = st_medkit
inv_weight          = 0.0
cost                = 0
inv_grid_width      = 1
inv_grid_height     = 1
inv_grid_x          = 20
inv_grid_y          = 0

; effects moved here from the real medkit
eat_health          = 0.5
eat_satiety         = 0
eat_power           = 0.0
eat_radiation       = -0.05
wounds_heal_perc    = 0.3
eat_portions_num    = 1
eat_max_power       = 0.1

; GS medicine intoxication, read by gunsl_peredoz.script (GS medkit_regular).
; sqprop is proportional to what is already in the blood, mul multiplies it, the flat
; lsd_factor is the dose itself; _master replaces it from veteran up.
lsd_factor          = 0.25
lsd_factor_master   = 0.6
lsd_factor_sqprop   = 0.8
