; The hidden phantom that carries the real effect, eaten by the hud model's binder after
; effect_delay (gwr_eatable_object). It has no engine-side effect at all: everything this item does
; is the one script key below.
;
; GS's antidote takes 0.8 off the intoxication level and then drips another 0.2/s for a minute,
; on top of chemical-burn protection. Neither is ported: no protection, and no partial relief --
; `lsd_clear` wipes the level outright, drip included (gunsl_peredoz.OnItemUsed). One dose, and
; whatever was in the blood is gone, however deep the hole was.

[drug_antidot_eatable]:identity_immunities
GroupControlSection = spawn_group
$spawn              = "weapons\drug_antidot_eatable"
$prefetch           = 8
; II_ANTIR for the same reason as the real item: this phantom sits in the inventory until
; effect_delay elapses, and an II_MEDKI there would be picked up by the medkit hotkey.
class               = II_ANTIR
cform               = skeleton
visual              = gwr\main\fake_object
description         = gunsl_eatable_antidot_descr
inv_name            = gunsl_eatable_antidot
inv_name_short      = gunsl_eatable_antidot
inv_weight          = 0.0
cost                = 0
inv_grid_width      = 1
inv_grid_height     = 1
inv_grid_x          = 20
inv_grid_y          = 0

eat_health          = 0
eat_satiety         = 0
eat_power           = 0
eat_radiation       = 0
wounds_heal_perc    = 0
eat_portions_num    = 1

; GS medicine intoxication, read by gunsl_peredoz.script: clear the level completely.
lsd_clear           = true
