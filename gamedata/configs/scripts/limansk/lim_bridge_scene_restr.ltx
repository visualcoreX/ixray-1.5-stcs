[logic]
active = sr_idle@spawn_squad

[sr_idle@spawn_squad]
on_info = sr_idle@abuse_smart6 %=create_squad(lim_csky_bridge_squad:lim_smart_terrain_5)%

[sr_idle@abuse_smart6]
on_actor_inside = sr_idle@cs_attack_1 %+lim_canal_scene_begin +lim_go_to_canal_complete%

[sr_idle@cs_attack_1]
on_info = {+lim_military_minigun_out =squad_exist(lim_csky_bridge_squad)} sr_idle@cs_attack_2

[sr_idle@cs_attack_2]
; orig target: sr_idle@nil
on_game_timer = 50 | sr_idle@house_debrief %=play_sound(lim_cs_storm_troop2_leader_order3:csky:st_ui_pda_legend_squad) =update_squad(lim_csky_bridge_squad)%

; The commander's debrief once the house is purged. He leaves his cover with the squad at once, so
; this waits for the player to come within 5 m of HIM wherever he is, and says it on him (npc theme).
; Squad gone (all dead) -> nobody to say it.
[sr_idle@house_debrief]
on_info = {!squad_exist(lim_csky_bridge_squad)} sr_idle@nil
on_info2 = {!smart_captured_by_faction(lim_smart_terrain_6:army) =actor_dist_to_squad_commander_le(lim_csky_bridge_squad:5)} sr_idle@nil %=play_sound_by_squad_commander(lim_csky_bridge_squad:lim_cs_storm_troop2_leader_to_actor6:csky:st_ui_pda_legend_squad) +lim_csky_house_debrief_done%

[sr_idle@nil]