[hud_base]

; Reload pressed while AIMING lowers the sights first (GS forbids the reload outright instead).
; The reload does not wait for anm_idle_aim_end to finish -- it starts this fraction of that
; animation BEFORE its end and blends over the rest. Bigger = the reload starts earlier and the
; two overlap more; 0 = wait for the aim-out to run out completely.
reload_aim_out_blend = 0.5
; How fast that reload mixes IN (blendAccrue, a rate -- higher = snappier handover). With the
; animation's own value the ramp is about as long as the rest of the aim-out, so the switch is only
; visible near its end no matter where it starts. 0 = keep the animation's own blend.
reload_aim_out_accrue = 8

; ============= GS Dynamic DOF (VERBATIM from GS weapons/base.ltx, its base hud section) =============
; Aim-DOF blend speeds, in 1/seconds. These OVERRIDE the [gunslinger_base] fallbacks (3/1) and are
; what GS actually ships: in over ~0.2s, out over ~0.5s.
zoom_in_dof_speed = 5
zoom_out_dof_speed = 2

; DOF while aiming through a 3D PiP scope: focus sits at ~1m with the far plane at 2m, so the world
; around the scope body blurs and the magnified image in the lens stays sharp. The section of the
; scope actually attached may override any of the three.
lens_dof_near = -10000
lens_dof_focus = 1
lens_dof_far = 2

; Shotgun shell loading: offset 0 means "do not release the DOF early" -- these anims are short and
; repeat, so pulling focus out before each one ends would flicker.
dof_time_offset_anm_open = 0
dof_time_offset_anm_open_empty = 0
dof_time_offset_anm_add_cartridge = 0
dof_time_offset_anm_add_cartridge_empty = 0
dof_time_offset_anm_add_cartridge_first = 0
dof_time_offset_anm_add_cartridge_preloaded = 0
dof_time_offset_anm_add_cartridge_empty_preloaded = 0
dof_time_offset_anm_add_cartridge_first_preloaded = 0

; the one action outside the reload family GS blurs by default: the dry-fire click on a jam
use_dof_anm_fakeshoot_jammed = true
; GS shot-animation mixing (WeaponAnims.pas NeedShootMix). A shot normally CUTS to its pose, which
; is what recoil wants -- but not when the hands are mid-way through something else, and the aim
; in/out transitions (anm_idle_aim_start / anm_idle_aim_end) are exactly that case: firing during
; them used to snap. Values are GS's own defaults from weapons/base.ltx. Queue mixing stays off
; here and is opted into per weapon, as GS does for its automatics.
mix_shoot_after_idle           = true
mix_shoot_after_reload         = true
mix_shoot_after_shoot_in_queue = false
; ---- GS controller-suicide defaults for a weapon with NO suicide animation (verbatim GS defines.ltx
; [hud_base]; GS lists an earlier pos/rot pair and overrides it right below, so this is the live one).
; The weapon is walked to this pose at suicide_speed_* and fires when it ARRIVES -- without the offset
; the target equals the normal pose and the shot goes off on the first frame. Weapons that do have an
; animation set suicide_by_animation = true and never reach this path. ----
suicide_speed_pos = 0.00205
suicide_speed_rot = 0.0901
no_other_hud_moving_while_suicide = true
; hands shake for the whole grab and fade out over jitter_stop_time after it lets go (GS IsHandJitter)
jitter_pos_amplitude = 0.002
jitter_rot_amplitude = 0.09
jitter_stop_time = 3
hud_move_suicide_offset_pos = 0.74, -0.18, 0.4
hud_move_suicide_offset_rot = 130, 15, -2
hud_move_suicide_offset_pos_16x9 = 0.74, -0.18, 0.4
hud_move_suicide_offset_rot_16x9 = 130, 15, -2

; ---- GS hud_move speeds/factors (verbatim GS defines.ltx; the engine code defaults 0.4/0.1 are
; glacial -- these are what make the offsets feel snappy) ----
hud_move_speed_rot = 3
hud_move_speed_pos = 2
hud_move_stabilize_factor = 3.5
hud_move_weaponhide_factor = 3.5
hud_move_unzoom_factor = 2.0
hud_move_slow_factor = 0.5
hud_move_crouch_factor = 0.5
hud_move_slow_crouch_factor = 0.3
