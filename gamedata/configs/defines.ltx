; ---- night-vision blackout (Gunslinger keeps these in its own defines.ltx, same idea) ----
; The goggles gesture plays on whatever HUD is out: with a weapon in hand it's the weapon's own
; anm_nv_on/off (CActor::SwitchNightVision routes it there and skips the empty-hands animator), so
; the keys have to live on every weapon -- hence hud_base. The engine looks up
; use_ppe_effector_<alias> / ppe_effector_<alias> / ppe_start_<alias> / ppe_end_<alias> for whatever
; alias it just played, so the _empty/_jammed twins need their own copies.
; NOTE: ppe_effector_* names an effector SECTION (ours takes a section, GS names the .ppe directly);
; gwr_effector_black lives in usable_items\action_animators\hud_objects.ltx.
; Windows are placed around OUR switch moment (g_torch_switch_delay), not GS's mark_anm_show.
use_ppe_effector_anm_nv_on				= true
ppe_effector_anm_nv_on					= gwr_effector_black
ppe_start_anm_nv_on						= 0.35
ppe_end_anm_nv_on						= 0.6

use_ppe_effector_anm_nv_on_empty		= true
ppe_effector_anm_nv_on_empty			= gwr_effector_black
ppe_start_anm_nv_on_empty				= 0.35
ppe_end_anm_nv_on_empty					= 0.6

use_ppe_effector_anm_nv_on_jammed		= true
ppe_effector_anm_nv_on_jammed			= gwr_effector_black
ppe_start_anm_nv_on_jammed				= 0.35
ppe_end_anm_nv_on_jammed				= 0.6

use_ppe_effector_anm_nv_off				= true
ppe_effector_anm_nv_off					= gwr_effector_black
ppe_start_anm_nv_off					= 0.355
ppe_end_anm_nv_off						= 0.655

use_ppe_effector_anm_nv_off_empty		= true
ppe_effector_anm_nv_off_empty			= gwr_effector_black
ppe_start_anm_nv_off_empty				= 0.355
ppe_end_anm_nv_off_empty				= 0.655

use_ppe_effector_anm_nv_off_jammed		= true
ppe_effector_anm_nv_off_jammed			= gwr_effector_black
ppe_start_anm_nv_off_jammed				= 0.355
ppe_end_anm_nv_off_jammed				= 0.655

; The double-barrels (CWeaponBM16) don't use _empty/_jammed -- they pick _0/_1/_2 by how many shells
; are loaded, so those aliases need their own keys or the gesture plays with no blackout.
use_ppe_effector_anm_nv_on_0			= true
ppe_effector_anm_nv_on_0				= gwr_effector_black
ppe_start_anm_nv_on_0					= 0.35
ppe_end_anm_nv_on_0						= 0.6

use_ppe_effector_anm_nv_on_1			= true
ppe_effector_anm_nv_on_1				= gwr_effector_black
ppe_start_anm_nv_on_1					= 0.35
ppe_end_anm_nv_on_1						= 0.6

use_ppe_effector_anm_nv_on_2			= true
ppe_effector_anm_nv_on_2				= gwr_effector_black
ppe_start_anm_nv_on_2					= 0.35
ppe_end_anm_nv_on_2						= 0.6

use_ppe_effector_anm_nv_off_0			= true
ppe_effector_anm_nv_off_0				= gwr_effector_black
ppe_start_anm_nv_off_0					= 0.355
ppe_end_anm_nv_off_0					= 0.655

use_ppe_effector_anm_nv_off_1			= true
ppe_effector_anm_nv_off_1				= gwr_effector_black
