;------------------------------------------------------------------------
; Attack On Move (CoP): the boar charges past the target, hits on the run,
; loops out and comes back in. Engine: CStateMonsterAttackOnRun.
; Our OMF has a single charge motion, so both sides point at the same one.
;------------------------------------------------------------------------

aom_enabled								=	1
aom_animation_left						=	stand_attack_run_
aom_animation_right						=	stand_attack_run_
aom_far_radius							=	8
aom_max_go_close_time					=	8
aom_prepare_time						=	4
aom_attack_radius						=	1
aom_update_side_period					=	3
aom_prediction_factor					=	1.2

;------------------------------------------------------------------------
; Gunslinger: a connecting hit can knock the weapon out of the actor's hands.
; The blow first eats stamina (hit power * hit_stamina_k); only when it is bigger
; than what is left does the item fly, with a chance of (stamina_hit - stamina).
; So a rested actor keeps his gun, a winded one loses it. Engine: CBaseMonster::try_knock_actor_weapon.
;------------------------------------------------------------------------

hit_weapon_drop							=	1
hit_stamina_k							=	1.2	; GS boar_stamina_hit_k
hit_weapon_cond_dec_min					=	0.05	; GS boar_hit_conditiondecmin
hit_weapon_cond_dec_max					=	0.25	; GS boar_hit_conditiondecmax
hit_weapon_drop_dist					=	-1	; <=0 = no unconditional drop (GS value)
hit_view_kick_yaw_min					=	4	; view jolt, degrees, scaled by the hit power
hit_view_kick_yaw_max					=	8
hit_view_kick_pitch_min					=	3
hit_view_kick_pitch_max					=	6

; GS boar kick camera motions (anims\camera_effects\weapon\boar_hit_*.anm) instead of the
; generic monster_base set. Sections at the bottom of this file.
