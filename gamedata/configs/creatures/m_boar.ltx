;***************************************************************
; Gunslinger skin armour (ported 2026-08-09, engine: CBaseMonster::Hit).
; A bullet whose k_ap beats skin_armor is scaled by (k_ap-skin)/k_ap but never below
; hit_fraction_monster; one that does not pierce keeps only hit_fraction_monster.
; tuned down from GS 0.5/0.24 to keep FMJ at the old CS level
;***************************************************************
[boar_protections]
skin_armor				= 0.29
hit_fraction_monster	= 0.106

;***************************************************************
; Boar hit camera effectors -- Gunslinger boar_hit_front/back motions.
; Keys are spelled out instead of inheriting effector_monster_hit: that parent lives in the
; packed misc\postprocess.ltx and may be parsed after this file.
;***************************************************************
[effector_boar_hit_0]
cam_eff_cyclic	= 0
cam_eff_name	= camera_effects\weapon\boar_hit_front.anm

