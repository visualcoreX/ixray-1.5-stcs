; ------------------------------------------------------------------------------------------------
; Commands added by this mod. They had no default at all, so a fresh profile (or Reset to defaults
; in the key menu) left them unbound -- these are the keys the working setup uses.
; ------------------------------------------------------------------------------------------------
bind wpn_laser k7
bind wpn_flashlight k8
bind scope_brightness_plus kADD
bind scope_brightness_minus kSUBTRACT
bind wpn_alter_zoom mouse3
bind wpn_kick kZ
bind quick_grenade kLMENU
bind wpn_lower kT

; Stock Clear Sky commands that were missing a default here too, so the camera keys came up dead
; after a reset. These are the vanilla keys, nothing of ours.
bind cam_1 kNUMPAD1
bind cam_2 kNUMPAD2
bind cam_3 kNUMPAD3
