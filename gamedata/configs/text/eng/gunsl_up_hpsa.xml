<?xml version="1.0" encoding="windows-1251" ?>
<string_table>
<string id="gunsl_hpsa_up_barrel_sil_name">
     <text>Threaded barrel</text>
</string>
<string id="gunsl_hpsa_up_barrel_sil_descr">
     <text>Extended barrel, threaded for mounting a 9x19mm suppressor.</text>
</string>
<string id="gunsl_hpsa_up_barrel_dispersion_name">
     <text>Barrel adjustment</text>
</string>
<string id="gunsl_hpsa_up_barrel_dispersion_descr">
     <text>Reduces bullet dispersion, which improves accuracy.</text>
</string>
<string id="gunsl_hpsa_up_barrel_speed_name">
     <text>Rebored barrel</text>
</string>
<string id="gunsl_hpsa_up_barrel_speed_descr">
     <text>Faster twist rate increases muzzle velocity and reduces bullet dispersion.</text>
</string>
<string id="gunsl_hpsa_up_body_name">
     <text>Protective coating</text>
</string>
<string id="gunsl_hpsa_up_body_descr">
     <text>Application of a protective coating to the internal parts significantly reduces wear.</text>
</string>
<string id="gunsl_hpsa_up_polymer_buffer_name">
     <text>Polymer buffer</text>
</string>
<string id="gunsl_hpsa_up_polymer_buffer_descr">
     <text>Addition of a polymer buffer to the return mechanism reduces felt recoil.</text>
</string>
<string id="gunsl_hpsa_up_zapiratel_name">
     <text>Improved locking mechanism</text>
</string>
<string id="gunsl_hpsa_up_zapiratel_descr">
     <text>Improves obturation and muzzle velocity thanks to tighter lock-up.</text>
</string>
<string id="gunsl_hpsa_up_usm_recoil_name">
     <text>Match trigger</text>
</string>
<string id="gunsl_hpsa_up_usm_recoil_descr">
     <text>Decreases recoil, thus improving accuracy.</text>
</string>
<string id="gunsl_hpsa_up_mag_prujina_name">
     <text>Magazine spring</text>
</string>
<string id="gunsl_hpsa_up_mag_prujina_descr">
     <text>Thinner spring allows to slightly increase the capacity of the magazine.</text>
</string>
<string id="gunsl_hpsa_up_patronnik_name">
     <text>Chamber adjustment</text>
</string>
<string id="gunsl_hpsa_up_patronnik_descr">
     <text>Improves obturation and accuracy by removing play in the chamber.</text>
</string>
<string id="gunsl_hpsa_up_plastic_handle_name">
     <text>Plastic pistol grip</text>
</string>
<string id="gunsl_hpsa_up_plastic_handle_descr">
     <text>Plastic grip panels slightly reduce overall weight of the firearm and improve handling.</text>
</string>
<string id="gunsl_hpsa_up_shell_ejector_name">
     <text>Improved ejector</text>
</string>
<string id="gunsl_hpsa_up_shell_ejector_descr">
     <text>Improved ejector reduces the probability of malfunctions related to ejecting an empty case from the firearm.</text>
</string>
<string id="gunsl_hpsa_up_sights_name">
     <text>Tritium sights</text>
</string>
<string id="gunsl_hpsa_up_sights_descr">
     <text>Tritium-illuminated sights increase speed and comfort of aiming in poorly-lit environments.</text>
</string>
<string id="gunsl_hpsa_up_usm_rpm_name">
     <text>Trigger tuning</text>
</string>
<string id="gunsl_hpsa_up_usm_rpm_descr">
     <text>Modification of the trigger mechanism increases rate of fire, at the cost of durability.</text>
</string>
<string id="gunsl_hpsa_up_light_details_name">
     <text>Lightweight parts</text>
</string>
<string id="gunsl_hpsa_up_light_details_descr">
     <text>Reduces weight by replacing weapon parts with their modern light-alloy counterparts.</text>
</string>
<string id="gunsl_hpsa_up_zatvor_balancer_name">
     <text>Balanced slide</text>
</string>
<string id="gunsl_hpsa_up_zatvor_balancer_descr">
     <text>Balanced slide decreases muzzle climb and felt recoil.</text>
</string>
<string id="gunsl_hpsa_up_titan_details_name">
     <text>More durable parts</text>
</string>
<string id="gunsl_hpsa_up_titan_details_descr">
     <text>Parts more resistant to wear make the weapon more reliable.</text>
</string>
</string_table>
