</string>
<string id="gunsl_wpn_beretta_up_light_mag_name">
     <text>Lightweight magazine</text>
</string>
<string id="gunsl_wpn_beretta_up_light_mag_descr">
     <text>Reduces overall weight of the firearm by replacing the standard magazine with a lightweight counterpart.</text>
</string>
<string id="gunsl_wpn_beretta_up_anatomic_handle_name">
