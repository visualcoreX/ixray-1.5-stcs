</string>
<string id="gunsl_wpn_beretta_up_light_details_name">
     <text>Lightweight parts</text>
</string>
<string id="gunsl_wpn_beretta_up_light_details_descr">
     <text>Reduces weight by replacing weapon parts with their light-alloy counterparts.</text>
</string>
<string id="gunsl_wpn_beretta_up_spusk_rpm_name">
