;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BOLT
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[bolt]:identity_immunities,weapon_probability,default_weapon_params
class				= II_BOLT
cform				= skeleton
visual				= dynamics\devices\dev_bolt\dev_bolt.ogf
inv_name			= st_bolt
$prefetch 			= 16
inv_name_short		= st_bolt
inv_weight			= .0

ef_weapon_type		= 1


inv_grid_width		= 1
inv_grid_height		= 1
inv_grid_x			= 0
inv_grid_y			= 0

; xrMPE puts the bolt on slot 6, not 7 -- 7 is the GRENADE set (and the flare/detector), which is
; why the pack ships a full norm_torso_6_* family and norm_all_6_attack_* that nothing in vanilla
; CS uses. Grenades stay on 7.
animation_slot		= 6	; orig 7
single_handed		= 0

slot				= 5
hud					= bolt_hud
force_min			= 10
force_const			= 20
force_max			= 30
force_grow_speed		= 10

destroy_time		= 30000

cost				= 0

throw_point			= 0,0.4,0.5
throw_dir			= 0,0,1

PDM_disp_base           = 1.0
PDM_disp_vel_factor     = 1.0
PDM_disp_accel_factor   = 1.0
PDM_disp_crouch         = 1.0
PDM_disp_crouch_no_acc  = 1.0

[bolt_hud]:hud_base
fire_point				= 0,0,0
fire_bone				= wpn_body
attach_place_idx		= 0
item_visual				= dynamics\devices\dev_bolt\dev_bolt_hud
hands_position				= -0.021000,-0.160000,0.002500
hands_orientation			= -0.500000,1.000000,1.149999
hands_position_16x9				= 0.0,-0.13,0.03
hands_orientation_16x9			= 0.0,0.0,0.0
item_position			= 0 , 0 ,0
item_orientation		= 0 , 0 ,0
throw_point				= 0.0,0.4,0.3
throw_dir				= 0,0,1

; ==================== SEMI-AUTO / BASE ANIMATION SET (from Gunslinger) ====================

; ---- show / draw ----
anm_show = bolt_draw

; ---- hide / holster ----
anm_hide = bolt_hide

; ---- bore ----
anm_bore = bolt_bore

; ---- sprint (enter / loop / exit) ----
anm_idle_sprint_start = bolt_sprint_start
anm_idle_sprint = bolt_sprint
anm_idle_sprint_end = bolt_sprint_end

; ---- walk (fwd / slow / crouch) ----
anm_idle_moving = bolt_walk
anm_idle_moving_slow = bolt_slow
anm_idle_moving_crouch = bolt_slow_down
anm_idle_moving_crouch_slow = bolt_slow_super

; ---- idle ----
anm_idle = bolt_idle
anm_idle_slow = bolt_idle
anm_idle_crouch = bolt_idle
anm_idle_crouch_slow = bolt_idle

; ---- headlamp on / off ----
anm_headlamp_on = bolt_headflash
anm_headlamp_off = bolt_headflash

; ---- night vision on / off ----
anm_nv_on = bolt_headflash
anm_nv_off = bolt_headflash

; ---- throw / grenade ----
anm_throw_begin = bolt_throw_start
anm_throw_idle = bolt_throw_idle
anm_throw = bolt_throw_end

