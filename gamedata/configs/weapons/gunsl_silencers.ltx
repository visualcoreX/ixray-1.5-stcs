; Gunslinger silencers ported to Clear Sky (2026-07-24). One addon item per caliber/weapon, each with
; its own GS model (meshes\dynamics\weapons\addons\silencers\*.ogf, textures already present in wpn\).
; Adapted to the CS addon format: class W_SILENC (not GS's WP_SILEN), :identity_immunities base,
; GroupControlSection/cform/$prefetch like the stock [wpn_addon_silencer]. Params/cost/weight are GS's.
; Inventory icon: temporarily reuses the stock silencer icon (inv_grid 15,4) for ALL -- swap to a real
; per-silencer atlas later. The stock CS generic silencers [wpn_addon_silencer]/[..._rifle] were moved
; here from weapons.ltx (2026-07-24) and keep the CS generic model wpn_upgrade\wpn_silencer.ogf.

[wpn_pb_silencer]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency =
$spawn			= "weapons\addons\pb_silencer"
class			= W_SILENC
cform           = skeleton
visual          = dynamics\weapons\addons\silencers\silencer_pb.ogf
description		= gunsl_addon_silencer_pb_descr
$prefetch 		= 32
slot = -1
cost			= 200
inv_name		= gunsl_addon_silencer_pb
inv_name_short	= gunsl_addon_silencer_pb
inv_weight		= 0.2
inv_grid_width     = 2
inv_grid_height    = 1
inv_grid_x         = 29
inv_grid_y         = 21
bullet_hit_power_k		= 1.4
bullet_hit_impulse_k	= 1.0
bullet_speed_k	 		= 1.0
fire_dispersion_base_k	= 0.8
cam_dispersion_k		= 0.8
cam_dispersion_inc_k	= 0.9
muzzle_fx_offset		= 0, 0, 0.160	; flame/smoke/light start this far past the fire point: world model,
muzzle_fx_offset_hud	= 0, 0, 0.218	; ...hud model (to a scale of its own). A weapon may override both: silencer_muzzle_fx_offset(_hud)

