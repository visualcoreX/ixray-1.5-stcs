; The eyepiece circle: what the night vision tint, the rim shading, the glass distortion and the
; aberration keep to. A RADIUS IN SCREEN HEIGHTS, and the horizontal one is that divided by the
; aspect -- which is what 0.62 got wrong here: it reached past the top and bottom of the screen
; long before it reached the sides, so the effects stopped short of the aperture left and right.
; 0.72 reaches 0.40 of the width on 16:9 -- short of the screen edge on purpose, the corners of the
; picture are the binocular's own black art anyway.
scope_nv_mask_radius		= 0.72
; How hard the glass pulls the picture OUT towards the rim (the middle of the field stays flat).
; Engine default 0.12; a binocular's short, deeply curved oculars show far more of it than a rifle
; scope does, and there is a lot more glass here to show it on.
scope_2d_distortion			= 0.2	; 0.28 was too much
scope_zoom_factor			= 7.5


