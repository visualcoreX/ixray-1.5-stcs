; =====================================================================================
; SIG Sauer P220R "nimble" -- Gunslinger UNIQUE variant of wpn_sig220 (ported 2026-07-29).
; Own r-model visual/hud, own upgrade tree (upgrade_scheme_sig220r / up_sig220r_), unique
; star icon overlay. Inherits everything else from [wpn_sig220]. Spawn: `wpn_sig220_nimble`.
; =====================================================================================
[wpn_sig220_nimble]:wpn_sig220
$spawn               = "weapons\wpn_sig220_nimble"
description          = gunsl_wpn_sig220_nimble_descr
cost                 = 6000	; orig 3400
def_hide_bones       = sight, barrel_silencer, mag2, flash, laser
def_show_bones       = barrel, mag
hud                  = wpn_sig220_nimble_hud
condition_shot_dec       = 0.0017
condition_queue_shot_dec = 0.0017

upgrades           = vartree_sig220r_body, vartree_sig220r_ramka, vartree_sig220r_shell_ejector, vartree_sig220r_sights, vartree_sig220r_laser, vartree_sig220r_handle, vartree_sig220r_mag
installed_upgrades =
upgrade_scheme     = upgrade_scheme_sig220r
allowed_upgrades   = up_sig220r_

inv_name             = gunsl_wpn_sig220_nimble
inv_name_short       = gunsl_wpn_sig220_nimble
inv_grid_width       = 2
inv_grid_height      = 1
inv_grid_x           = 20
inv_grid_y           = 0

element_icon_0          = icon_element_sig220r_body
element_icon_offset_x_0  = 0
element_icon_offset_y_0  = 0

upgr_icon_x          = 1598
upgr_icon_y          = 534
upgr_icon_width      = 170
upgr_icon_height     = 139

uniq_icon            = upgrade_addon_icon_uniq_item
uniq_icon_offset_x   = 50
uniq_icon_offset_y   = 0

visual               = dynamics\weapons\wpn_sig220\wpn_sig220r.ogf

; laser/torch enabled by the flashlaser upgrade (ak74-style: node flips laser_installed/torch_installed;
; light params live in the sections below). Offsets from GS uniq flashlaser node -- may need in-game tuning.
laser_params_section      = sig220_laser
flashlight_params_section = sig220_flashlight
flashlight_bone           = light   ; toggle the glow LENS on/off (like ak74); the `flash` LASER
                                    ; device stays shown by the flashlaser upgrade's show_bones
; laser/torch toggle sounds -- engine plays sndLaserOn/sndFlashOn on toggle; without these
; keys the sound isn't loaded -> HUD_SOUND_COLLECTION assert on toggle. Reuse the l85 LAM click.
snd_laser_on  = weapons\l85\l85_lam
snd_laser_off = weapons\l85\l85_lam
snd_torch_on  = weapons\l85\l85_lam
snd_torch_off = weapons\l85\l85_lam

; world (3rd-person / dropped) animations -- r world model uses wpn_sig220_animation.omf
use_world_anims = true
wanm_idle              = idle
wanm_idle_empty        = idle_empty
wanm_idle_jammed       = idle_jammed
wanm_shoot             = shoot
wanm_shoot_jammed      = idle_jammed
wanm_shoot_last        = shoot_last
wanm_shoot_last_jammed = idle_jammed
wanm_reload            = idle
wanm_reload_empty      = idle
wanm_reload_jammed     = idle


