; ---- SIG220 laser (green LAM) params -- read after the flashlaser upgrade sets laser_installed.
; ak74-style; emitter = `laser` bone. World offset from GS sig220r flashlaser node. Tune in-game.
[sig220_laser]
laser_installed                = true
laser_ray_bones                = line
laser_beam_section             = laser_beam_green	; volumetric beam + procedural dot on R3 (configs\weapons\laser_beams.ltx)
particles_count                = 4
laserdot_particle_0            = laser\green_dot
laserdot_particle_1            = laser\green_dot1
laserdot_dist_1                = 0.1
laserdot_particle_2            = laser\green_dot2
laserdot_dist_2                = 7
laserdot_particle_3            = laser\green_dot3
laserdot_dist_3                = 15
laserdot_attach_bone           = line
; GS-universal offset (emitter on the `line` bone). Old center-lift measure was x=-0.10788 y=0.15297 z=0.
laserdot_attach_offset_x       = 0.0
laserdot_attach_offset_y       = 0.0
laserdot_attach_offset_z       = -0.6
; ---- laser behaviour (same set as usp45) ----
laserdot_correction            = true	; GS default: camera-pull -> converge to device + center-aim + constant size (with soft particles = smooth point-blank dissolve)
laserdot_hud_point_koef        = 0.0	; non-GS world->hud reprojection OFF
laserdot_zero_dist             = 3	; parallax zero: dot centered from 10m outward (aiming), converges to the device closer, gun sway preserved. Fine-tune y offset above if the close-up dot is off the device
laserdot_world_attach_offset_x = 0.0
laserdot_world_attach_offset_y = 0.06
laserdot_world_attach_offset_z = 0.144
laserdot_dists_count           = 3
laserdot_dist_treshold_1       = 0.5
laserdot_dist_scale_1          = 0.08
laserdot_dist_treshold_2       = 10
laserdot_dist_scale_2          = 0.03
laserdot_dist_treshold_3       = 40
laserdot_dist_scale_3          = 0.05

