[wpn_lr300_minigame]:wpn_lr300    ;new weapon for minigame "Shooting"
shell_casing_override	= shell_casing_556x45	; the case of the real gun, not of the stand-in ammo_minigame round
ammo_limit      = 100
;ammo_mag_size   = 10
ammo_class      = ammo_minigame
fire_modes      = 1
$spawn          = "weapons\wpn_lr300_minigame"
cost            = 0
quest_item 		= true
upgrades                = up_gr_ab_lr300, up_gr_cd_lr300, up_gr_ef_lr300, up_gr_gh_lr300, up_gr_i_lr300
installed_upgrades      = up_b_lr300,up_d_lr300,up_bd_lr300
upgrade_scheme          = upgrade_scheme_u15_nolamp

[wpn_lr300_up2]:wpn_lr300	;LR300 М1
$spawn          = "weapons\uniq\wpn_lr300_up2"

upgrades                = up_gr_ab_lr300, up_gr_cd_lr300, up_gr_ef_lr300, up_gr_gh_lr300, up_gr_i_lr300
