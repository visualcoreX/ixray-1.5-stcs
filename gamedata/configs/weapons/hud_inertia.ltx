;==============================================================================
; Spring-damper HUD sway (player_hud::update_inertion, CHudItem::Load)
;
; How fast the view turns sets where the weapon should hang (gain * turn rate),
; and the weapon chases that as a damped spring: it trails the turn and comes
; back when the turn stops. damping < 1 swings past centre on the way back
; (0.5 ~ 16% overshoot, 0.35 ~ 30%, 1.0 = none).
;
; Every key is looked up in this order:
;   1. the weapon's hud section                     (wpn_xxx_hud)
;   2. the profile it names: inertia_profile = <section below>
;   3. [hud_inertia]
;   4. the engine default (the values written in [hud_inertia])
; Prefixes: inertia_ = hip, inertia_aim_ = aiming, inertia_gl_ = grenade launcher.
; Aim falls back to hip with a third of the rotation gains, gl to aim.
;
; Keys (after the prefix):
;   rot_yaw / rot_pitch / rot_roll  rad of tilt per rad/s of turning (roll from the
;                                   yaw rate). Positive = lags behind; negative flips it
;   rot_freq                        Hz, how fast the rotation returns
;   rot_damping                     <1 overshoots, 1 does not
;   rot_max                         degrees, limit per axis
;   rot_pivot                       x,y,z in camera space (m) the hud turns about
;   pos_x / pos_y                   m of shift per rad/s of turning
;   pos_freq / pos_damping / pos_max (m)
;   pitch_offset_r / _n / _d        static hud pose by how far the view looks up or
;                                   down (vanilla pitch compensation), m per rad.
;       A weapon's own old inertion_pitch_offset_* (hud section) still wins over
;       the profile; with no value anywhere: [gunslinger_base] inertion_default_* /
;       inertion_aim_default_*.
;   handling_ref / handling_mag / handling_freq / handling_damping
;       coupling to control_inertion_factor (the weapon's "handling", lowered by
;       upgrades, read live): h = factor / handling_ref;
;       gains * h^mag, frequencies / h^freq, rotation damping / h^damping. 0 = off.
;
; pos_x / pos_y are NOT set in [hud_inertia] on purpose: a weapon without them
; takes them from its old inertion_origin_offset / inertion_speed (GS tuning), or
; from [gunslinger_base], so it shifts as much as it used to. Setting them here
; would override that for every weapon that has no own value.
; Profiles are multiplied by the handling factor on top, so a heavy profile on a
; weapon with control_inertion_factor 2.2 gets heavier still.
;==============================================================================

[hud_inertia]
inertia_rot_pitch           = 0.01
inertia_rot_yaw             = 0.01
inertia_rot_roll            = 0.0075
inertia_rot_pivot           = 0.0,-0.25,0.25
inertia_pos_x               = -0.0075
inertia_pos_y               = 0.0075
inertia_pos_freq            = 2.0
inertia_rot_freq            = 2.5
inertia_pos_damping         = 1.0
inertia_rot_damping         = 0.5
inertia_rot_max             = 2.5
inertia_pos_max             = 0.05
inertia_handling_ref        = 2.0 ;0 - disable
inertia_handling_mag        = 0.75 ;0 - disable
inertia_handling_freq       = 0.6 ;0 - disable
inertia_handling_damping    = 0.5 ;0 - disable

inertia_aim_rot_pitch           = -0.0005
inertia_aim_rot_yaw             = -0.0005
inertia_aim_rot_roll            = 0.015
inertia_aim_rot_pivot           = 0.0, -0.05, 0.25
inertia_aim_pos_x               = 0.001
inertia_aim_pos_y               = 0.001
inertia_aim_pos_freq            = 2.0
inertia_aim_rot_freq            = 2.0
inertia_aim_pos_damping         = 1.0
inertia_aim_rot_damping         = 0.5
inertia_aim_rot_max             = 0.5
inertia_aim_pos_max             = 0.005
inertia_aim_handling_ref        = 2.0 ;0 - disable
inertia_aim_handling_mag        = 0.75 ;0 - disable
inertia_aim_handling_freq       = 0.50 ;0 - disable
inertia_aim_handling_damping    = 0.50 ;0 - disable

