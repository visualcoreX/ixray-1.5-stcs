upgrade_addon_icon_offset_y = 48
upgrade_addon_icons_hide    = icon_element_g36_mag
; swap the standard magazine + magwell for the extended pair on the HUD model.
; children (ammo40_*) follow their parent -- set_bone_visible is recursive, and naming a child
; here would fight the re-hide pass in gwr_UpdateBones.
; magazin/magazin40 are the WORLD model's pair (hud has mag30*/mag40*); both lists go to both
; models, so one line covers the weapon in the hands and on the ground / on an NPC.
hide_bones = magwell, mag30, mag30_2, magazin
show_bones = magwell_adv, mag40, mag40_2, magazin40

