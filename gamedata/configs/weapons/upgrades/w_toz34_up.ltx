; Gunslinger toz34 upgrade tree (ported from GS shotguns/toz34/upgrades.ltx, 9 nodes / 6 vartree).
; Mechanics: obrez (stock/barrel saw-off = bone swap + icon shrink), rifled barrel (ammo_class +
; hud swap), and the weaver rail (scope_status=2 + scopes_sect -> scope_rakurs_toz34).

;------------------------------------------toz34_stock------------------------------------------
[up_sect_toz34_stock]
cost = 500
show_bones = stock_short
hide_bones = stock

cam_dispersion = +2.0
inv_weight              = -0.8

zoom_cam_dispersion = +1.5
zoom_cam_dispersion_inc = +1
zoom_cam_dispersion_frac = +1
crosshair_inertion = -0.5

PDM_disp_base = 0.8

actor_camera_speed_factor = 1.5

upgrade_addon_icons_hide = icon_element_toz34_stock
inv_grid_width = -1
inv_grid_x = +1
inv_addons_correction_x = -50

pistol_slot_allowed = +0.6

[up_toz34_stock]
scheme_index = 0, 0
known = 1
effects = vartree_toz34_usm
section = up_sect_toz34_stock
property = prop_shortstock
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_stock_name
description =gunsl_toz34_up_stock_descr
icon = ui_gunsl_up_toz34_stock
;------------------------------------------toz34_plate------------------------------------------
[up_sect_toz34_plate]
cost = 500
value = -20
cam_relax_speed = +2
cam_dispersion = -1
cam_dispersion_inc = -1
cam_dispersion_frac = -0.1
zoom_cam_relax_speed = +1.0
zoom_cam_dispersion = -0.5
zoom_cam_dispersion_inc    = -0.5
zoom_cam_dispersion_frac = -0.1
PDM_disp_base = -0.2

[up_toz34_plate]
scheme_index = 0, 1
known = 1
effects = vartree_toz34_usm
section = up_sect_toz34_plate
property = prop_recoil
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_plate_name
description =gunsl_toz34_up_plate_descr
icon = ui_gunsl_up_toz34_plate
;------------------------------------------toz34_usm------------------------------------------
[up_sect_toz34_usm]
cost = 2000
value = +20
misfire_start_prob	     	= -0.001
misfire_end_prob	     	= -0.005
misfire_start_condition = -0.3
misfire_end_condition		= -0.05
inv_weight = -0.1

[up_toz34_usm]
scheme_index = 0, 2
known = 1
effects = vartree_toz34_calibration
section = up_sect_toz34_usm
property = prop_reliability
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_usm_name
description =gunsl_toz34_up_usm_descr
icon = ui_gunsl_up_toz34_usm
;------------------------------------------toz34_calibration------------------------------------------
[up_sect_toz34_calibration]
cost = 3000
value = 30
fire_dispersion_base    = -0.04
cam_dispersion		= -2
zoom_cam_dispersion	= -1
hit_power		=1.3,1.3,1.3,1.3
PDM_disp_base  = -0.1

[up_toz34_calibration]
scheme_index = 0, 3
known = 1
effects = 
section = up_sect_toz34_calibration
property = prop_dispersion
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_calibration_name
description =gunsl_toz34_up_calibration_descr
icon = ui_gunsl_up_toz34_calibration
;------------------------------------------toz34_barrel------------------------------------------
[up_sect_toz34_barrel]
cost = 700
inv_weight              = -0.9
crosshair_inertion = -2.0
control_inertion_factor = -0.3 
bullet_speed = -80 
fire_dispersion_base = +0.125
bullet_speed = -100
fire_distance = -50
hit_power = 1.2
flame_particles		   	= ghost_particles\weapons\flame_12cal_toz34_buckshot
muzzle_fx_offset     = 0, 0, -0.345	; flame/smoke back to the sawn-off muzzle (barrel_short ends 0.345 before barrel)
muzzle_fx_offset_hud = 0, 0, -0.511	; same on the hud model, which is to a bigger scale

actor_camera_speed_factor = 1.5

show_bones = barrel_short
hide_bones = barrel

hud                        = wpn_toz34_fast_hud
; ammo_class deliberately NOT set here. GS listed its own full 2-cartridge set (a no-op for
; GS), but re-declaring it is a SET, not a delta -- installing this after the rifled barrel
; put buckshot back. Only up_sect_toz34_barrel_narezka may change ammo_class.

upgrade_addon_icons_hide = icon_element_toz34_barrel
inv_grid_width = -1
inv_addons_correction_x = +15

pistol_slot_allowed = +0.6

[up_toz34_barrel]
scheme_index = 0, 4
known = 1
effects = 
section = up_sect_toz34_barrel
property = prop_shortbarrel
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_barrel_name
description =gunsl_toz34_up_barrel_descr
icon = ui_gunsl_up_toz34_barrel
;------------------------------------------toz34_sights------------------------------------------
[up_sect_toz34_sights]
cost = 300
show_bones = sight
crosshair_inertion = -0.3
control_inertion_factor = -0.1

[up_toz34_sights]
scheme_index = 0, 5
known = 1
effects = 
section = up_sect_toz34_sights
property = prop_lightingsights
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_sights_name
description =gunsl_toz34_up_sights_descr
icon = ui_gunsl_up_toz34_sights
;------------------------------------------toz34_reliability------------------------------------------
[up_sect_toz34_reliability]
cost = 1500
value = +20
condition_shot_dec      	= -0.003
condition_queue_shot_dec	= -0.003
misfire_probability        = -0.001

[up_toz34_reliability]
scheme_index = 0, 6
known = 1
effects = vartree_toz34_calibration
section = up_sect_toz34_reliability
property = prop_reliability
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_reliability_name
description =gunsl_toz34_up_reliability_descr
icon = ui_gunsl_up_toz34_reliability
;------------------------------------------toz34_weaver------------------------------------------
[up_sect_toz34_weaver]
cost = 900
show_bones = rail, scope4
; scope_status intentionally NOT set here: the base weapon is already attachable, and an
; upgrade that sets scope_status makes the engine read scope_name/scope_x/scope_y from THIS
; section (WeaponUpgrade.cpp:251-262) -> fatal. Appending scopes_sect is enough (= ak74 rail).
scopes_sect = scope_rakurs_toz34
inv_weight = +0.1

upgrade_addon_icon = upgrade_addon_icon_rail_picatiny_1
upgrade_addon_icon_offset_x = 102
upgrade_addon_icon_offset_y = 0

[up_toz34_weaver]
scheme_index = 0, 7
known = 1
effects = 
section = up_sect_toz34_weaver
property = prop_scope_attach
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_weaver_name
description =gunsl_toz34_up_weaver_descr
icon = ui_gunsl_up_toz34_weaver
;------------------------------------------toz34_barrel_narezka------------------------------------------
[up_sect_toz34_barrel_narezka]
cost = 2000
value = +30
value2 = st_no_buck	; vanilla CS mechanism: property_functor_a appends translate(value2) to the property text
bullet_speed = 100
condition_queue_shot_dec = 0.002
condition_shot_dec = 0.002
fire_dispersion_base = -0.06
ammo_class = ammo_12x76_zhekan, ammo_12x76_dart	; +dart: rifling bans SHOT, not the flechette round (GS had no dart)
hit_impulse    = +25
PDM_disp_base = -0.15
hit_power		=1.2,1.2,1.2,1.2
hud = wpn_toz34_fast_hud_invertedammo

[up_toz34_barrel_narezka]
scheme_index = 0, 8
known = 1
effects = vartree_toz34_calibration
section = up_sect_toz34_barrel_narezka
property = prop_dispersion	; was: prop_dispersion, prop_destruction,  prop_no_buck -- our engine reads ONE property name
precondition_functor = inventory_upgrades.precondition_functor_a
precondition_parameter = true
effect_functor = inventory_upgrades.effect_functor_a
effect_parameter  = something_here
prereq_functor  = inventory_upgrades.prereq_functor_a
prereq_tooltip_functor  = inventory_upgrades.prereq_tooltip_functor_a
prereq_params  = 
name =gunsl_toz34_up_barrel_narezka_name
description =gunsl_toz34_up_barrel_narezka_descr
icon = ui_gunsl_up_toz34_barrel_narezka
;------------------------------------------------------------------------------------
[vartree_toz34_stock]
elements = up_toz34_stock, up_toz34_plate
[vartree_toz34_barrel_global]
elements = up_toz34_barrel, up_toz34_sights
[vartree_toz34_rail]
elements = up_toz34_weaver
[vartree_toz34_usm]
elements = up_toz34_usm
[vartree_toz34_barrel_inside]
elements = up_toz34_reliability, up_toz34_barrel_narezka
[vartree_toz34_calibration]
require_all_parent_groups = true	; unlock only when usm AND the barrel-inside branch each have a pick
elements = up_toz34_calibration
