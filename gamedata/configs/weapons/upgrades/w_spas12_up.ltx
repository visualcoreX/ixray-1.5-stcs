[up_sect_protecta_rail]
cost = 2000
inv_weight = +0.1
show_bones = rail, scope1, scope2, scope3, scope4
scope_status = 2
; REQUIRED with scope_status here (WeaponUpgrade.cpp:251-262 reads these from the upgrade
; section). Values = the first scope in the list (eotech), from GS scopes.ltx.
