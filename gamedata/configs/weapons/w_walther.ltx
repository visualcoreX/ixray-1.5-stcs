installed_upgrades      =
upgrade_scheme          = upgrade_scheme_wpn_walther

; =========================================================================
; Walther P99 laser (green LAM) params -- read after the flashlaser upgrade sets laser_installed.
; ak74-style; emitter = `line` bone (GS convention). World offset from GS walther flashlaser node.
; Dot particles use red_dot (green_dot particle group not confirmed in our particles.xr -- swap to
; laser\green_dot* if it exists). Offsets likely need in-game tuning.
; =========================================================================
[walther_laser]
laser_installed                = true
laser_ray_bones                = line
particles_count                = 4
laserdot_particle_0            = laser\green_dot
laserdot_particle_1            = laser\green_dot1
laserdot_dist_1                = 0.1
laserdot_particle_2            = laser\green_dot2
laserdot_dist_2                = 7
laserdot_particle_3            = laser\green_dot3
laserdot_dist_3                = 15
laserdot_attach_bone           = line
; GS-universal offset (emitter on the `line` bone). Old center-lift measure was x=-0.12037 y=0.18569.
laserdot_attach_offset_x       = 0.0
laserdot_attach_offset_y       = 0.03
laserdot_attach_offset_z       = -0.6
; ---- laser behaviour (same set as usp45) ----
laserdot_correction            = true	; GS default: camera-pull -> converge to device + center-aim + constant size (with soft particles = smooth point-blank dissolve)
laserdot_hud_point_koef        = 0.0	; non-GS world->hud reprojection OFF
laserdot_zero_dist             = 3	; parallax zero: dot centered from 10m outward (aiming), converges to the device closer, gun sway preserved. Fine-tune y offset above if the close-up dot is off the device
laserdot_world_attach_offset_x = 0.0
laserdot_world_attach_offset_y = 0.1
laserdot_world_attach_offset_z = 0.135
laserdot_dists_count           = 3
laserdot_dist_treshold_1       = 0.5
laserdot_dist_scale_1          = 0.08
laserdot_dist_treshold_2       = 10
laserdot_dist_scale_2          = 0.03
laserdot_dist_treshold_3       = 40
laserdot_dist_scale_3          = 0.05

; =========================================================================
; Walther P99 flashlight params -- read after the flashlaser upgrade sets torch_installed.
; ak74-style spot+omni+glow; offsets from GS walther flashlaser node. Likely need in-game tuning.
; =========================================================================
[walther_flashlight]
torch_light_bone               = wpn_body
torch_attach_offset_x          = 0.0
torch_attach_offset_y          = 0.0
torch_attach_offset_z          = 0.3	; orig -0.2 -- emitter pushed past the muzzle: at ~0 the weapon and the camera sit inside the cone (screen-wide glare, bright at the edges)
torch_world_attach_offset_x    = 0.0
torch_world_attach_offset_y    = 0.074
torch_world_attach_offset_z    = 0.129
torch_omni_attach_offset_x     = 0.0
torch_omni_attach_offset_y     = 0.0
torch_omni_attach_offset_z     = -0.2
torch_omni_world_attach_offset_x = 0.0
torch_omni_world_attach_offset_y = 0.074
torch_omni_world_attach_offset_z = 0.129
torch_spot_angle               = 60
torch_spot_texture             = internal\internal_light_torch_tactical_r2	; GS weapon-torch texture (soft edge)
torch_r2_range                 = 50
torch_r2_color_r               = 0.6
torch_r2_color_g               = 0.55
torch_r2_color_b               = 0.55
torch_r2_color_a               = 1.0
torch_r2_omni_range            = 0.25
torch_r2_omni_color_r          = 1.0
torch_r2_omni_color_g          = 1.0
torch_r2_omni_color_b          = 1.0
torch_r2_omni_color_a          = 0.0
create_glow                    = true
torch_glow_texture             = glow\glow_torch_r2
torch_glow_radius              = 0.3
