; ===== TOZ-34 per-weapon scope sections (from GS shotguns/toz34/scopes.ltx) =====
; IMPORTANT: our engine reads scope_texture + scope_zoom_factor from the ACTIVE SCOPE SECTION
; (WeaponMagazined.cpp:2220-2223, unconditional) -- GS keeps them on the scope ITEM, so GS sections
; copied verbatim are incomplete for us. Everything else read from a scope section is line_exist-guarded.
; GS key renames: GS hud_fov_zoom_factor -> our scope_hud_fov_aim; GS min/max_lens_factor +
; lens_factor_levels_count -> our scope_lens_factor. GS `overriding_hide_bones` / `collimator` we do not read.

; PU 3.5x -- the base weapon's mount. GS enables use_scope_anims ONLY here.
[scope_pu_toz34]
scope_name              = wpn_addon_scope_pu
scope_texture           = crosshair_2d_pu
scope_zoom_factor       = 28	; the value stock CS used for the PU on this weapon
scope_hud_fov_aim       = 0.34	; GS hud_fov_zoom_factor 0.6 x our base hud fov (psHUD_FOV_def 0.45 * GS hud_fov_factor 1.25 = 0.5625); orig 0.27 was too close
use_scope_anims         = true
need_lens_frame         = true
scope_lens_factor       = 6.0	; GS min/max_lens_factor 6
scope_abberation        = 0.008
zoom_mouse_sense_koef   = 0.5
scope_x                 = 62
scope_y                 = 1
bones                   = scope3, scope4_sight
aim_hud_offset_pos      = -0.009800,-0.0183000,-0.15
aim_hud_offset_rot      = 0.007000,0.000000,0.000000
aim_hud_offset_pos_16x9 = -0.009800,-0.0183000,-0.15
aim_hud_offset_rot_16x9 = 0.001000,0.000000,0.000000
inertion_aim_origin_offset = 0.01
inertion_aim_speed      = 10

; Rakurs COLLIMATOR -- mountable after up_toz34_weaver. GS-faithful: NO use_scope_anims, NO lens frame,
; and scope_texture = zero_alpha (its reticle is on the model, so no 2D crosshair overlay is drawn).
; scope_zoom_factor stays on OUR scale (GS's own 1.06 is theirs); 55 matches our scope_rakurs_ak74m.
[scope_rakurs_toz34]
scope_name              = wpn_addon_scope_rakurs
scope_texture           = zero_alpha
scope_zoom_factor		= 98	; 1x collimator -- no world zoom (98 ~= none on our scale; base gives 55)
scope_hud_fov_aim       = 0.48	; GS hud_fov_zoom_factor 0.85 x our base hud fov (psHUD_FOV_def 0.45 * GS hud_fov_factor 1.25 = 0.5625); orig 0.38 was too close
; MUST be true in OUR engine even though GS omits it. Our engine has only TWO scope modes:
; need_lens_frame=false -> UseScopeTexture()=true -> ZoomTexture()!=NULL -> need_renderable()=false,
; i.e. the vanilla 2D-scope path that HIDES THE WEAPON and draws a fullscreen scope picture (with
; zero_alpha that means the gun simply vanishes). Only the lensed path keeps the weapon rendered.
; GS gets a third mode from its own `collimator = true`, which our engine does not implement.
; TRUE collimator mode (engine `collimator`): weapon + HUD stay visible, no PiP lens, no world
; zoom. GS-faithful -- this is GS's own `collimator = true` key, now implemented in our engine.
collimator              = true
need_lens_frame         = false
scope_abberation        = 0.003	; GS value
scope_x                 = 101
scope_y                 = -2
bones                   = scope2
aim_hud_offset_pos      = -0.009100,-0.014700,0.0
aim_hud_offset_rot      = -0.001000,0.000000,0.000000
aim_hud_offset_pos_16x9 = -0.009100,-0.013600,0.0
aim_hud_offset_rot_16x9 = 0.001000,0.000000,0.000000
inertion_aim_origin_offset = 0.02
inertion_aim_speed      = 8

