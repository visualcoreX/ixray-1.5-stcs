;==============================================================================
; PGO-7V -- the RPG-7's own 2.7x optic (GS heavy/rpg-7/scopes.ltx + addons/scopes/lastochka/std_pgo7v.ltx)
;==============================================================================
[wpn_addon_scope_pgo7v]:wpn_addon_scope_x2.7	; PGO-7V 2.7x (2D reticle + PiP lens)
$spawn			= "weapons\addons\scope_pgo7v"
visual          = dynamics\weapons\addons\scopes\pgo7v.ogf
inv_name		= gunsl_addon_scope_pgo7v
inv_name_short	= gunsl_addon_scope_pgo7v
description		= gunsl_addon_scope_pgo7v_descr
cost			= 3000
inv_weight		= .62
inv_grid_width     = 1
inv_grid_height    = 1
inv_grid_x         = 22
inv_grid_y         = 25
holder_range_modifier	= 1.2
holder_fov_modifier		= 1.0
scope_texture		= crosshair_2d_pgo7v
scope_zoom_factor	= 40	; GS 1.02 is a multiplier there; ours is absolute degrees (2.7x optic)
zoom_hide_ui		= true
need_lens_frame		= true
scope_lens_factor	= 15	; GS min = max = 15
zoom_mouse_sense_koef = 0.13
scope_abberation	= 0.005
; brightness steps (GS std_pgo7v.ltx): the reticle has an illuminated variant
max_night_brightness	= 3.0
min_night_brightness	= 0.0
steps_brightness		= 1
default_brightness_step	= 0
jitter_brightness		= 0.0

; ---- mount: PGO-7V on the RPG-7 (GS heavy/rpg-7/scopes.ltx) ----
[scope_pgo7v_rpg7]
scope_name              = wpn_addon_scope_pgo7v
scope_texture           = crosshair_2d_pgo7v
scope_zoom_factor       = 40
need_lens_frame         = true
scope_lens_factor       = 15
min_lens_factor         = 15
max_lens_factor         = 15
lens_factor_levels_count = 5
zoom_mouse_sense_koef   = 0.13
; How long after the aim rotation the 2D picture waits (and the weapon goes away with it).
; Engine default 0.04 -- this optic comes up slower than a rifle scope, so it holds on longer.
scope_2d_show_delay     = 0.095
scope_abberation        = 0.005
use_scope_anims         = true
scope_hud_fov_aim       = 0.225	; GS hud_fov_zoom_factor 0.4 x 0.5625 (same conversion as the groza's 0.422)
scope_x                 = 135	; offset in the inventory icon
scope_y                 = 11
; reticle illumination -- the bone (as on the PSO mounts) AND the brightness block, which MUST live
; in THIS section: LoadScopeIllumParams reads the per-weapon scope section (then the weapon), never
; the addon item -- with the keys only on [wpn_addon_scope_pgo7v] steps stayed 0 and the step could
; never leave 0, so nothing ever switched.
scope_illum_bones       = metka1
steps_brightness        = 1
max_night_brightness    = 3.0
min_night_brightness    = 0.0
default_brightness_step = 0
; same shape as the working svu mounts: `bones` = the optic's own geometry, and the mount swap goes
; through overriding_hide/show (scope on -> `mount` away, `mount_off` in; scope off -> the def_* pass
; on the weapon puts `mount` back and hides `mount_off`)
bones                   = scope1
overriding_hide_bones   = mount
overriding_show_bones   = mount_off
aim_hud_offset_pos      = 0.0,0.008,0.00
aim_hud_offset_rot      = 0.000000,0.000000,0.000000
aim_hud_offset_pos_16x9 = 0.0,0.008,0.00
aim_hud_offset_rot_16x9 = 0.000000,0.000000,0.000000
inertion_aim_origin_offset = 0.009	; scope sections keep GS's POSITIVE sign (only hud sections are mirrored)
inertion_aim_speed_factor  = 0.8

