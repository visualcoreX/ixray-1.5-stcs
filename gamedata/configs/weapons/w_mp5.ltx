;==============================================================================
; Laser designator + weapon flashlight params (GS up_sect_mp5_laser :red_laser and
; up_sect_mp5_torch :tactical_torch, rewired the ak74 way: the upgrade node only flags the
; devices on, all the geometry lives here and is pointed at from the weapon section).
;==============================================================================
[mp5_laser]
laser_installed                = true
; the beam toggles the `line` bone -- `laser` is the physical device (shown by the upgrade)
laser_ray_bones                = line
laser_beam_section             = laser_beam_red	; volumetric beam + procedural dot on R3 (configs\weapons\laser_beams.ltx)
particles_count                = 4
laserdot_particle_0            = laser\red_dot
laserdot_particle_1            = laser\red_dot1
laserdot_dist_1                = 0.1
laserdot_particle_2            = laser\red_dot2
laserdot_dist_2                = 7
laserdot_particle_3            = laser\red_dot3
laserdot_dist_3                = 15
laserdot_attach_bone           = line
laserdot_attach_offset_x       = -0.04515
laserdot_attach_offset_y       = -0.00299
laserdot_attach_offset_z       = -0.6
laserdot_correction            = true
laserdot_hud_point_koef        = 0.0
laserdot_zero_dist             = 3
; GS mp5 world (3rd person / dropped) offsets, from up_sect_mp5_laser
laserdot_world_attach_offset_x = 0.0
laserdot_world_attach_offset_y = 0.1
laserdot_world_attach_offset_z = 0.05
laserdot_dists_count           = 3
laserdot_dist_treshold_1       = 0.5
laserdot_dist_scale_1          = 0.08
laserdot_dist_treshold_2       = 10
laserdot_dist_scale_2          = 0.03
laserdot_dist_treshold_3       = 40
laserdot_dist_scale_3          = 0.05
laser_breaking_params          = 0.15, 0.14, 1.0
laser_problems_level           = 3

[mp5_flashlight]
; the lit lens is `light`; `flash` is the device body revealed by the upgrade
torch_light_bone               = light
torch_attach_offset_x          = -0.008
torch_attach_offset_y          = 0.048
torch_attach_offset_z          = 0.45	; orig 0.0 -- emitter pushed past the muzzle: at ~0 the weapon and the camera sit inside the cone (screen-wide glare, bright at the edges)
torch_world_attach_offset_x    = 0.0
torch_world_attach_offset_y    = 0.05
torch_world_attach_offset_z    = 0.25
torch_omni_world_attach_offset_x = 0.0
torch_omni_world_attach_offset_y = 0.05
torch_omni_world_attach_offset_z = 0.25
torch_spot_angle               = 60
torch_spot_texture             = internal\internal_light_torch_tactical_r2
torch_r2_range                 = 50
torch_r2_color_r               = 0.6
torch_r2_color_g               = 0.55
torch_r2_color_b               = 0.55
torch_r2_color_a               = 1.0
torch_r2_omni_range            = 0.25
torch_r2_omni_color_r          = 1.0
torch_r2_omni_color_g          = 1.0
torch_r2_omni_color_b          = 1.0
torch_r2_omni_color_a          = 0.0
create_glow                    = true
torch_glow_texture             = glow\glow_torch_r2
torch_glow_radius              = 0.3
