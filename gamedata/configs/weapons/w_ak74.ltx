; ---- GS world-model animations (ReassignWorldAnims) -------------------------------------------------
; Animate the WORLD model (third person / dropped / NPC hands) from wpn_ak74_animation.omf, which carries
; the same 16 motions GS uses. The engine picks a base key from the weapon state (wanm_idle / wanm_shoot /
; wanm_reload, plus wanm_draw / wanm_holster if present -- omitted here, as in GS, so they fall back to
; wanm_idle), then appends suffixes ONLY when the resulting key exists, in this order:
;   _last (fired the last round) -> _jammed | _empty -> firemode (_a auto, _1/_2/_3) -> _g | _w_gl
; The key's VALUE is the motion name inside the omf. Values copied verbatim from GS aks74 base.ltx.
use_world_anims = true

wanm_idle        = idle
wanm_idle_a      = idle_auto
wanm_idle_w_gl   = idle_gl_off
wanm_idle_a_w_gl = idle_gl_off_auto
wanm_idle_g      = idle_gl_on
wanm_idle_a_g    = idle_gl_on_auto

wanm_idle_empty        = idle
wanm_idle_empty_a      = idle_auto
wanm_idle_empty_w_gl   = idle_gl_off
wanm_idle_empty_a_w_gl = idle_gl_off_auto
wanm_idle_empty_g      = idle_gl_on
wanm_idle_empty_a_g    = idle_gl_on_auto

wanm_idle_jammed        = idle_jammed
wanm_idle_jammed_a      = idle_jammed_auto
wanm_idle_jammed_w_gl   = idle_gl_off_jammed
wanm_idle_jammed_a_w_gl = idle_gl_off_jammed_auto
wanm_idle_jammed_g      = idle_gl_on_jammed
wanm_idle_jammed_a_g    = idle_gl_on_jammed_auto

wanm_shoot        = shoot
wanm_shoot_a      = shoot_auto
wanm_shoot_w_gl   = shoot_gl_off
wanm_shoot_a_w_gl = shoot_gl_off_auto
wanm_shoot_g      = idle_gl_on
wanm_shoot_a_g    = idle_gl_on_auto

wanm_shoot_jammed        = idle_jammed
wanm_shoot_jammed_a      = idle_jammed_auto
wanm_shoot_jammed_w_gl   = idle_gl_off_jammed
wanm_shoot_jammed_a_w_gl = idle_gl_off_jammed_auto
wanm_shoot_jammed_g      = idle_gl_on_jammed
wanm_shoot_jammed_a_g    = idle_gl_on_jammed_auto

wanm_shoot_last        = shoot
wanm_shoot_last_a      = shoot_auto
wanm_shoot_last_w_gl   = shoot_gl_off
wanm_shoot_last_a_w_gl = shoot_gl_off_auto
wanm_shoot_last_g      = idle_gl_on
wanm_shoot_last_a_g    = idle_gl_on_auto

wanm_shoot_last_jammed        = idle_jammed
wanm_shoot_last_jammed_a      = idle_jammed_auto
wanm_shoot_last_jammed_w_gl   = idle_gl_off_jammed
wanm_shoot_last_jammed_a_w_gl = idle_gl_off_jammed_auto
wanm_shoot_last_jammed_g      = idle_gl_on_jammed
wanm_shoot_last_jammed_a_g    = idle_gl_on_jammed_auto

wanm_reload        = idle
wanm_reload_a      = idle_auto
wanm_reload_w_gl   = idle_gl_off
wanm_reload_a_w_gl = idle_gl_off_auto
wanm_reload_g      = idle_gl_on
wanm_reload_a_g    = idle_gl_on_auto

wanm_reload_empty        = idle
wanm_reload_empty_a      = idle_auto
wanm_reload_empty_w_gl   = idle_gl_off
wanm_reload_empty_a_w_gl = idle_gl_off_auto
wanm_reload_empty_g      = idle_gl_on
wanm_reload_empty_a_g    = idle_gl_on_auto

wanm_reload_jammed        = idle
