; =========================================================================
; ak74 laser (ЛЦУ) params -- read after the laser upgrade sets laser_installed. Dot emitter = `line` bone.
; Offsets are GS's: HUD laserdot_attach_offset from base_laser.ltx [red_laser]; world offset = GS ak74
; [up_sect_ak74_laser] override. Particles from GS particles.xr (laser\red_dot*).
; =========================================================================
[ak74_laser]
laser_installed                = true
laser_ray_bones                = line, line2
particles_count                = 4
laserdot_particle_0            = laser\red_dot
laserdot_particle_1            = laser\red_dot1
laserdot_dist_1                = 0.1
laserdot_particle_2            = laser\red_dot2
laserdot_dist_2                = 7
laserdot_particle_3            = laser\red_dot3
laserdot_dist_3                = 15
laserdot_attach_bone           = line
; GS-universal offset (emitter on the `line` bone). Old center-lift measure was x=-0.09247 y=0.05793.
laserdot_attach_offset_x       = -0.05293
laserdot_attach_offset_y       = -0.00253
laserdot_attach_offset_z       = -0.6
; ---- laser behaviour (same set as usp45) ----
laserdot_correction            = true	; GS default: camera-pull -> converge to device + center-aim + constant size (with soft particles = smooth point-blank dissolve)
laserdot_hud_point_koef        = 0.0	; non-GS world->hud reprojection OFF
laserdot_zero_dist             = 3	; parallax zero: dot centered from 10m outward (aiming), converges to the device closer, gun sway preserved. Fine-tune y offset above if the close-up dot is off the device
laserdot_world_attach_offset_x = -0.037
laserdot_world_attach_offset_y = 0.244
laserdot_world_attach_offset_z = 0.347
laserdot_dists_count           = 3
laserdot_dist_treshold_1       = 0.5
laserdot_dist_scale_1          = 0.08
laserdot_dist_treshold_2       = 10
laserdot_dist_scale_2          = 0.03
laserdot_dist_treshold_3       = 40
laserdot_dist_scale_3          = 0.05

; =========================================================================
; ak74 weapon-mounted flashlight (фонарь) params -- read after the torch upgrade sets torch_installed.
; Bone + offsets are GS's: torch_light_bone=wpn_body and HUD torch_attach_offset from base_torch.ltx
; [tactical_torch]; world offset = GS ak74 [up_sect_ak74_torch] override. The visible `flash` device is
; shown by the upgrade's show_bones.
; =========================================================================
[ak74_flashlight]
torch_light_bone               = wpn_body
torch_attach_offset_x          = -0.008
torch_attach_offset_y          = 0.048
torch_attach_offset_z          = 0.45	; orig 0.0 -- emitter pushed past the muzzle: at ~0 the weapon and the camera sit inside the cone (screen-wide glare, bright at the edges)
torch_world_attach_offset_x    = 0.049
