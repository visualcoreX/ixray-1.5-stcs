; ---- attachment bones shown/hidden by default (verbatim from Gunslinger's aks74 base.ltx) ----
; The GS hud.ogf carries a mesh for every optional scope/mag/rail; without GS's upgrade system they
; would all render at once. Hide them all here and show only the base set. Bones the model lacks are
; skipped silently, so the list can stay as GS ships it.
def_show_bones = mag30, handler, foregrip
def_hide_bones = mag45, mag45_black, mag60, handler2, scope_cobra, scope_rakurs, scope_pso_sniper, scope_kashtan, scope_pka, scope_pso_assault, scope_nv_sniper, scope_nv_assault, flash, light, laser, line, line2, sight, sight2, foregrip_rail, knife, tilnik, metka_pso_assault

launch_speed            = 0
hand_dependence         = 1
single_handed           = 0

slot                    = 2                ; // secondary
animation_slot          = 2                ; type of the animation that will be used
actor_anim_group_gl_off   = 2_gloff	; xrMPE actor (third-person) animation set from stalker_animation_new.omf
actor_anim_group_gl_on    = 2_glon

inv_name          = st_wpn_ak74                    ; name in inventory
inv_name_short    = st_wpn_ak74
inv_weight        = 3.6	; orig 3.3 (GS); weight in inventory

inv_grid_width       = 5    ; position and size of the icon that will be used to display weapon in the inventory menu
inv_grid_height      = 2    ; all icons are on the texture ui_icon_equipment.dds,
; Position/size are in grid cells of 50 px (INV_GRID_WIDTHF; it is 100 only when inventory/use_hq_icons
; is on, which it is not here). The old "64x64 squares" note was wrong -- at 64 px these coords would
; run past the 2048x2048 atlas. Moved onto GS's own ak74 icon slot so the layered element sprites
; (element_icon_0 = icon_element_ak74_body) line up over the same artwork Gunslinger composes on.
inv_grid_x           = 20   ; orig 5
inv_grid_y           = 0    ; orig 5

kill_msg_x        = 0
kill_msg_y        = 28
kill_msg_width    = 84
kill_msg_height      = 28

;-------------------------------------------------------------------------------
;params of weapon recoil
fire_dispersion_base       	= 0.19	; Gunslinger aks74 base dispersion (deg); orig 0.8
control_inertion_factor    	= 1.2f

;recoil
cam_relax_speed             = 5	; orig 5 (GS); recoil recovery speed (return to the original position)
cam_relax_speed_ai      	= 360
cam_dispersion              = 0.8	; muzzle-rise angle increase (deg) per shot
cam_dispersion_inc         	= 0.5	; cam_dispersion increase per shot
cam_dispersion_frac        	= 1.0	; barrel rises by cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle				= 50.0	; maximum recoil angle
cam_max_angle_horz         	= 5.0      ;(degree) maximum shot horizontal degree
cam_step_angle_horz        	= 0.35		;(degree) size of step camera moved in horizontal position while shooting

zoom_cam_relax_speed         = 5	    ; scope & ironsight
zoom_cam_relax_speed_ai      = 360
zoom_cam_dispersion          = 0.45
zoom_cam_dispersion_inc      = 0.45
zoom_cam_dispersion_frac     = 0.7
zoom_cam_max_angle           = 50.0
zoom_cam_max_angle_horz      = 5.0
zoom_cam_step_angle_horz     = 0.3

fire_dispersion_condition_factor    = 15	; dispersion increase (percent) at maximum wear (GS aks74)
misfire_probability     = 0.005		; legacy (unused while misfire_start_condition>0); orig 0.0003
misfire_condition_k     = 0.05
; --- Gunslinger condition-range jam model (aks74) ---
misfire_start_condition = 0.5		; above this condition: no jams
misfire_end_condition   = 0.1		; at/below this: max jam chance
misfire_start_prob      = 0.003		; jam chance at start_condition
misfire_end_prob        = 0.033		; jam chance at end_condition
condition_shot_dec      = 0.0002	; wear per single shot (GS); orig 0.0001
