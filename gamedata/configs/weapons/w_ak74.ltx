scope_x                 = 39
scope_y                 = 5

; ---- GS layered inventory icon ----
; The cell icon is composed from sprites rather than one static picture: the body plus the stock
; magazine. Each upgrade adds its own layer and hides the base sprite it replaces (via
; upgrade_addon_icons_hide), so fitting a 45/60-round mag visibly changes the inventory icon.
; Offsets are in atlas pixels. Values from GS assault/aks74/base.ltx.
element_icon_0 = icon_element_ak74_body
element_icon_offset_x_0 = 0
element_icon_offset_y_0 = 0
element_icon_1 = icon_element_mag_545_bakelite_stock
element_icon_offset_x_1 = 100
element_icon_offset_y_1 = 0
; GS laser (ЛЦУ) + weapon-mounted flashlight (фонарь): installed by the laser/torch upgrades (foregrip_rail branch).
; The engine reads these param sections only after laser_installed/torch_installed is flipped by the upgrade.
laser_params_section    = ak74_laser
flashlight_params_section = ak74_flashlight
flashlight_bone         = light   ; the glow lens toggled with on/off (the `flash` device stays visible)
disable_laserdot_when_gl_enabled = true   ; GS: in GL mode the projected dot is hidden -> the laser reads as a short stub
bayonet_hit_time        = 210   ; ms after the quick-kick key when the bayonet stab lands (anm_kick=ak74_bayonet plays on the weapon)
; bayonet melee params (GS base_bayonet.ltx) -- read by QuickKickHit when the ak74 stabs. Reaches further +
; hits harder than the generic knife kick (quick_kick_animator: distance 2, power 0.8). Only used while the
; bayonet is the active melee (the stab won't fire otherwise).
kick_distance           = 3.0   ; GS base_bayonet (vs 2.0 for the knife phantom)
kick_hit_power          = 1.5
kick_hit_impulse        = 10
kick_wallmark_size      = 0.05
laser_switch_time_to_gl   = 500   ; GS: dot stays for the first 500ms of the raise-GL anim, then hides
laser_switch_time_from_gl = 700   ; GS: dot reappears only in the last 700ms of the lower-GL anim
scope_bones             = scope_pso_assault   ; fallback bone (per-scope sections' `bones` override this)
need_lens_frame         = true               ; GS: this scope uses the 3D PiP lens (no 2D scope texture, weapon stays visible)
scope_lens_factor       = 10                  ; GS PSO min/max_lens_factor (magnification if the scope filled the screen); lens frame FOV = base/factor
use_scope_anims         = true                ; GS: while a scope is attached play the _scope anim variants (anm_shoot_aim_scope)
scope_abberation        = 0.005               ; GS PSO: PiP lens chromatic aberration (R/B edge split); shader m_hud_params.z
zoom_mouse_sense_koef   = 0.2                  ; GS PSO x10: look-sensitivity multiplier while scoped (lower = slower for higher magnification)
; GS scope reticle illumination. Brightness is a PER-SCOPE property now: the optics that support it
; (pso1/pso1m2x1/night/detector/nvas/nvsn) define steps_brightness/max_night_brightness in their own
; [scope_*_ak74m] sections. The weapon-level steps_brightness was REMOVED because it made collimators
; (cobra/rakurs/pka/kashtan), which have no brightness of their own, inherit it via the LoadScopeIllum
; fallback -> the brightness key + click sound wrongly worked on them. Only scope_illum_bones stays as
; a harmless bone-hide fallback.
scope_illum_bones       = metka_pso_assault    ; glowing reticle bone shown only while illumination is on (must be in def_hide_bones)
snd_scope_brightness_plus  = weapons\nv_intensity   ; GS: click when the reticle/NV brightness step goes up
snd_scope_brightness_minus = weapons\nv_intensity   ; GS: click when it goes down
scope_x              	= 39                 ; offset in inventory icon
scope_y                 = 5
