; GS multi-scope: the weapon accepts any of these per-weapon scope sections; each names its addon item and
; carries its own bones/offsets/zoom/lens. scope_name is the default (PSO) used as a fallback.
; rakurs is intentionally NOT here -- the foregrip_rail ("крепление для прицела") upgrade appends scope_rakurs_ak74m at runtime.
scopes_sect             = scope_kashtan_ak74m, scope_nvas_ak74m, scope_cobra_ak74m, scope_pka_ak74m, scope_pso1m2x1_ak74m, scope_pso1_ak74m, scope_nvsn_ak74m   ; orig also had scope_rakurs_ak74m
