misfire_end_condition = 0.1
misfire_start_prob = 0.002
misfire_end_prob = 0.08
condition_queue_shot_dec = 0.0045

allowed_upgrades = up_toz34_
scopes_sect = scope_pu_toz34	; the up_toz34_weaver upgrade adds scope_rakurs_toz34 on top
; scope_status = 2 makes the engine read scope_name/scope_x/scope_y from the WEAPON section
; unconditionally (Weapon.cpp:446-457), so a multi-scope weapon still needs this default/fallback
; item -- exactly what ak74 does. Values = the PU's, from [scope_pu_toz34].
