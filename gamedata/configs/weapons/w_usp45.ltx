; =========================================================================
; USP laser designator params -- read after the flashlaser upgrade sets laser_installed.
; RED dot (GS red_laser), emitter bone `line`. World offset from GS flashlaser node.
; HUD laserdot_attach_offset likely needs in-game tuning.
; =========================================================================
[usp_laser]
laser_installed                = true
; GS DEFAULT: camera-pull compression -> dot projects to the SAME hit-point screen pos (so it still converges to
; the device as you approach + aims at center), but drawn at a compressed near-camera distance = CONSTANT small
; size (doesn't balloon point-blank like real-depth). With soft particles on it dissolves smoothly at a surface.
laserdot_correction            = true
laser_ray_bones                = line
particles_count                = 4
laserdot_particle_0            = laser\red_dot
laserdot_particle_1            = laser\red_dot1
laserdot_dist_1                = 0.1
laserdot_particle_2            = laser\red_dot2
laserdot_dist_2                = 7
laserdot_particle_3            = laser\red_dot3
laserdot_dist_3                = 15
laserdot_attach_bone           = line
; GS base_laser.ltx [red_laser] verbatim: same offset GS uses for EVERY weapon (relies on the `line` bone).
laserdot_attach_offset_x       = 0.0
laserdot_attach_offset_y       = -0.03
laserdot_attach_offset_z       = -0.6
laserdot_hud_point_koef        = 0.0	; my non-GS world->hud reprojection OFF (0 = pure GS behavior)
laserdot_zero_dist             = 3	; parallax zero: angle the ray so the dot crosses screen center at 10m (aiming); works in correction=on too (it edits dir), sway + device-convergence preserved
laserdot_surface_pull          = 0.85	; GS value (verified: GS TraceAsView traces from the same origin + dist*=0.85). Tuning knob only; 1.0 = on the object
laserdot_world_attach_offset_x = 0.0
laserdot_world_attach_offset_y = 0.06
laserdot_world_attach_offset_z = 0.144
laserdot_dists_count           = 3
laserdot_dist_treshold_1       = 0.5
laserdot_dist_scale_1          = 0.08
laserdot_dist_treshold_2       = 10
laserdot_dist_scale_2          = 0.03
laserdot_dist_treshold_3       = 40
laserdot_dist_scale_3          = 0.05

