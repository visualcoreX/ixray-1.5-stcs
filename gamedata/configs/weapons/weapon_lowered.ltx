; Weapon down (key wpn_lower, CActor::ToggleWeaponLowered / CWeapon::UpdateLoweredPose).
; The move on the hud is two hands-rig animations (OMF, only bip01 moving), layered additively on bip01 over
; whatever the hud plays. Paths in meshes\, without .omf; read at game start.

[weapon_lowered]
anim_down		= dynamics\weapons\weapon_lowered\weapon_lowered	; frame 0 = up, last frame = down. Without it the
																	; weapon does not move on the hud (warning in the log)
anim_up			= dynamics\weapons\weapon_lowered\weapon_raised		; frame 0 = down, last frame = up. Without it the
																	; way down plays backwards
anim_blend		= 0.15			; s: a change of direction mid-move (or a way up that does not start exactly where
								; the way down ends) fades over from the current pose in this long
