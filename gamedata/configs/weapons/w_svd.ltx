anm_nv_on_empty = svd_headflash, idle_empty
anm_nv_on_jammed = svd_headflash, idle_jammed
anm_nv_off = svd_headflash
anm_nv_off_empty = svd_headflash, idle_empty
anm_nv_off_jammed = svd_headflash, idle_jammed

; ---- bayonet / kick / attack ----
anm_kick = svd_bayonet
anm_kick_empty = svd_bayonet, idle_empty
anm_kick_jammed = svd_bayonet, idle_jammed

; ==================== AUTO-FIRE MODE ANIMATION SET (mask_firemode_a = _auto) ====================


; ---- GS behaviour keys from sniper/svd/huds.ltx (lock_time_*, autoshoot_*, kick timings)
inertion_origin_offset = -0.05	; GS raw 0.05 -- our hud inertia axes are inverted
inertion_aim_origin_offset = -0.007	; GS raw 0.007 -- our hud inertia axes are inverted
inertion_aim_speed = 10
grenade_bone            = grenade
disable_bore = true
mix_shoot_after_idle = true
autoshoot_anm_idle_aim_start = true
lock_time_anm_idle_aim_start = 0.2
autoshoot_anm_idle_aim_start_empty = true
lock_time_anm_idle_aim_start_empty = 0.2
autoshoot_anm_idle_aim_start_jammed = true
lock_time_anm_idle_aim_start_jammed = 0.2
autoshoot_anm_idle_aim_end = true
lock_time_anm_idle_aim_end = 0.25
autoshoot_anm_idle_aim_end_empty = true
lock_time_anm_idle_aim_end_empty = 0.25
autoshoot_anm_idle_aim_end_jammed = true
lock_time_anm_idle_aim_end_jammed = 0.25
enable_directions_anm_idle_aim = true
lock_time_anm_idle_sprint_start = 0.15
lock_time_anm_idle_sprint_start_empty = 0.15
lock_time_anm_idle_sprint_start_jammed = 0.15
lock_time_anm_idle_sprint_end        = 0.35
lock_time_anm_idle_sprint_end_empty  = 0.35
lock_time_anm_idle_sprint_end_jammed = 0.35
lock_time_anm_fakeshoot_empty = 0.20
lock_time_anm_fakeshoot_aim_empty = 0.20
lock_time_anm_fakeshoot_jammed = 1.1
lock_time_anm_fakeshoot_aim_jammed = 0.20
use_unloadmag_anim = true
lock_time_anm_unload_mag = 0.8
lock_time_anm_unload_mag_jammed = 0.8
lock_time_anm_unload_mag_empty = 0.8
; generic lock_time (ak74 values): ends the stab before the motion's dead tail so it can be
; interrupted -- separate from GS's start/end pair below, which times the hit window.
lock_time_anm_kick = 0.9
lock_time_anm_kick_empty = 0.9
lock_time_anm_kick_jammed = 0.9
lock_time_start_anm_kick = 0.17
lock_time_end_anm_kick = 1.0
lock_time_start_anm_kick_empty = 0.17
lock_time_end_anm_kick_empty = 1.0
lock_time_start_anm_kick_jammed = 0.17
lock_time_end_anm_kick_jammed = 1.0
lock_time_start_anm_headlamp_on = 0.58
lock_time_end_anm_headlamp_on = 0.5
lock_time_start_anm_headlamp_on_empty = 0.58
lock_time_end_anm_headlamp_on_empty = 0.5
lock_time_start_anm_headlamp_on_jammed = 0.58
lock_time_end_anm_headlamp_on_jammed = 0.5
lock_time_start_anm_headlamp_off = 0.58
lock_time_end_anm_headlamp_off = 0.5
lock_time_start_anm_headlamp_off_empty = 0.58
lock_time_end_anm_headlamp_off_empty = 0.5
lock_time_start_anm_headlamp_off_jammed = 0.58
lock_time_end_anm_headlamp_off_jammed = 0.5