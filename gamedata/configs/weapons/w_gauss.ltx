; ---------------------------------------------------------------------------------------------
; GS scope_nightvision effector (GS weapons\addons\scopes\effectors\nightvision_gauss.ltx). The
; `nv` upgrade node points scope_nightvision at this section; the engine runs its ppe while the
; player aims through the optic, at a strength set by the reticle-brightness step.
; ---------------------------------------------------------------------------------------------
[scope_nightvision_gauss]
snd_night_vision_on			= $silent
snd_night_vision_off		= $silent
snd_night_vision_idle		= $silent
snd_night_vision_broken		= $silent

pp_eff_name = nightvision_gauss.ppe
pp_eff_cyclic = 1
pp_eff_overlap = false
; 2D picture (3D lens off): the pp pass applies the gauss lens formula (grey-blue lift by the
; brightness value) inside the eyepiece instead of a plain gain -- both modes brighten alike
pp_nv_2d_lens_tint = true
; with the suit's NV on too, the goggles grade the picture and this optic only amplifies: its lift
; becomes a gain (1 + 20*brightness), times this (1 = its ppe carries no gain of its own)
pp_nv_2d_chain_gain = 1.0

; ---------------------------------------------------------------------------------------------
; scope_alive_detector params (GS weapons\addons\scopes\effectors\alive_detector_base.ltx). The
; `detector` upgrade node points scope_alive_detector here; the engine then runs the VANILLA
; binoculars vision (CBinocularsVision) while aiming -- same keys w_binoc.ltx uses.
; ---------------------------------------------------------------------------------------------
[scope_detector]
vis_frame_speed				= 14				; how fast the frame crawls onto the target
vis_frame_color				= 0.7,0.7,0.7,1.0	; frame RGBA
found_snd					= detectors\DA-2_beep1
catch_snd					= detectors\DA-2_beep1
