zoom_enabled				= true
zoom_rotate_time			= 0.25
scope_zoom_factor			= 5		;���-1 4X

scope_texture				= crosshair_2d_gauss
; ---- 3D PiP lens for the built-in optic (GS base.ltx). IsLensedScope reads these from the ACTIVE
; scope section, else the WEAPON section -- the hud section is never consulted, which is why the
; scope fell back to the flat 2D picture. Values are GS's own.
need_lens_frame         = true
min_lens_factor         = 15
max_lens_factor         = 15
lens_factor_levels_count = 1
zoom_mouse_sense_koef   = 0.13
scope_abberation        = 0.006
lens_speed              = 0.0
lens_gyro_sound_period  = 0.38
