; ttc
; GS reaches 2.0 total via its ammo (k_hit = 2.0) with hit_power 1.0. We put the factor on the
; WEAPON instead: ammo_gauss is shared with [wpn_gauss_aes], the quest AES gauss, and that one
; must keep its own 0.14 -- it overrides hit_power, so a change here cannot reach it.
hit_power               = 2.0, 2.0, 2.0, 2.0	; orig 1.0 (GS wpn_gauss total damage)
hit_impulse		 			= 100
hit_type 					= fire_wound

hit_probability_gd_novice	= 1
hit_probability_gd_stalker	= 1
hit_probability_gd_veteran	= 1
hit_probability_gd_master	= 1

fire_distance           = 1000
bullet_speed            = 1500	; orig 15000 (GS wpn_gauss)
rpm                     = 150	; orig 25 (GS wpn_gauss)
rpm_empty_click         = 150	; orig 200 (GS wpn_gauss)
; GS recharge_time: seconds the capacitor needs between shots, on top of the rpm delta.
; The fast_conders (-1.0) and ionistori (-0.3) upgrade nodes shorten it.
recharge_time           = 3		; GS wpn_gauss
; No shot queue here: with a 3 s gap a trigger pull made during the recharge would fire seconds
; later and read as a phantom shot. Every other weapon queues (engine default = true).
shot_queue              = false
; end ttc

use_aim_bullet			= false		;�������������� �� ������ ������ ����
