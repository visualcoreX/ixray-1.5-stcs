anm_reload_empty_detector                 = glock18_det_reload_full, glock18_reload_full
anm_reload_ammochange_detector            = glock18_det_reload, glock18_reload
anm_reload_empty_ammochange_detector      = glock18_det_reload_full, glock18_reload_full
anm_reload                                = glock18_reload, glock18_reload
anm_reload_empty                          = glock18_reload_full
anm_reload_ammochange                     = glock18_reload, glock18_reload
anm_reload_empty_ammochange               = glock18_reload_full

anm_reload_auto                           = glock18_reload, glock18_reload_auto
anm_reload_auto_empty                     = glock18_reload_full, glock18_reload_full_auto
anm_reload_auto_ammochange                = glock18_reload, glock18_reload_auto
anm_reload_auto_empty_ammochange          = glock18_reload_full, glock18_reload_full_auto
anm_reload_auto_detector                  = glock18_det_reload, glock18_reload_auto
anm_reload_auto_empty_detector            = glock18_det_reload_full, glock18_reload_full_auto
anm_reload_auto_ammochange_detector       = glock18_det_reload, glock18_reload_auto
anm_reload_auto_empty_ammochange_detector = glock18_det_reload_full, glock18_reload_full_auto

; our engine culls the laser dot past this angle (default 10 = it vanishes off-center);
; GS has no such key -- its behaviour is "hide only when pointing away".

; glock17 laser params -- GS base_laser.ltx [red_laser] + this weapon's own overrides.
[glock17_laser]
laser_installed = true
laser_ray_bones = line


particles_count = 4 ; число различных партиклов
laserdot_particle_0 = laser\red_dot

laserdot_particle_1 = laser\red_dot1
laserdot_dist_1 = 0.1
laserdot_particle_2 = laser\red_dot2
laserdot_dist_2 = 7
laserdot_particle_3 = laser\red_dot3
laserdot_dist_3 = 15

laserdot_attach_bone = line 
laserdot_attach_offset_x = 0.0
laserdot_attach_offset_y = 0.017
laserdot_attach_offset_z = -0.6

laserdot_world_attach_offset_x = 0.0	; glock17 override (GS up_sect_glock17_torch)
laserdot_world_attach_offset_y = 0.1	; glock17 override (GS up_sect_glock17_torch)
laserdot_world_attach_offset_z = 0.05	; glock17 override (GS up_sect_glock17_torch)

laserdot_dists_count = 3

laserdot_dist_treshold_1 = 0.5
laserdot_dist_scale_1 = 0.08

laserdot_dist_treshold_2 = 10
laserdot_dist_scale_2 = 0.03

laserdot_dist_treshold_3 = 40
laserdot_dist_scale_3 = 0.05

//при дистанции 5 точка становится визуально неразличима

laser_breaking_params = 0.15, 0.14, 1.0; //состояние, при котором начнутся проблемы, состояние, при котором все совсем поломается, стартовая вероятность проблемы (конечная - конечно же, 1)
laser_problems_level = 3 ;параметр отключения при выбросе



laserdot_correction            = true
laserdot_hud_point_koef        = 0.0
laserdot_zero_dist             = 10.0
laserdot_surface_pull          = 0.85

; glock17 flashlight params -- GS base_torch.ltx [tactical_torch] + this weapon's own overrides.
[glock17_flashlight]
;---------------------------------------
;DIRECT		= 0,
;POINT		= 1,
;SPOT		= 2,
;OMNIPART	= 3,
;REFLECTED	= 4,

torch_render_type = 2 
torch_omni_type = 2

torch_render_shadow = true
torch_omni_shadow = false
;---------------------------------------

torch_installed = true
torch_light_bone = wpn_body
torch_cone_bones = light

torch_attach_offset_x = -0.008
torch_attach_offset_y = 0.048
torch_attach_offset_z = 0.3	; orig 0.0 -- emitter pushed past the muzzle: at ~0 the weapon and the camera sit inside the cone (screen-wide glare, bright at the edges)

torch_world_attach_offset_x = 0.0
torch_world_attach_offset_y = 0.05
torch_world_attach_offset_z = 0.25


torch_omni_attach_offset_x = 0.0 
torch_omni_attach_offset_y = 0.0
torch_omni_attach_offset_z = 0.0

torch_omni_world_attach_offset_x = 0.0 
torch_omni_world_attach_offset_y = 0.0
torch_omni_world_attach_offset_z = 0.0

torch_glow_radius = 0.3
torch_glow_texture = glow\glow_torch_r2

torch_color_r = 1.2
torch_color_g = 1.2
torch_color_b = 1.2
torch_color_a = 0.9

torch_r2_color_r = 0.6
torch_r2_color_g = 0.55
torch_r2_color_b = 0.55
torch_r2_color_a = 1.0

torch_omni_color_r = 1.0 
torch_omni_color_g = 1.0
torch_omni_color_b = 1.0
torch_omni_color_a = 0.0

torch_r2_omni_color_r = 1.0 
torch_r2_omni_color_g = 1.0
torch_r2_omni_color_b = 1.0
torch_r2_omni_color_a = 0.0

torch_range = 50
torch_r2_range = 50
torch_omni_range = 0.25 
torch_r2_omni_range = 0.25 

torch_spot_angle = 60
torch_spot_texture    = internal\internal_light_torch_tactical_r2

torch_breaking_params = 0.3, 0.25, 0.0 //состояние, при котором начнутся проблемы, состояние, при котором все совсем поломается, стартовая вероятность проблемы (конечная - конечно же, 1)
