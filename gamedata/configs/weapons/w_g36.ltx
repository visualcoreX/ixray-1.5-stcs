scope_name              = wpn_addon_scope_susat
; ---- 3D (PiP) lens for the BUILT-IN optic.
; need_lens_frame is what CWeapon::IsLensedScopeCfg reads. With scope_status = 1 the engine does
; not load scope_name at all (Weapon.cpp:534 gates it on eAddonAttachable), so there is no "current
; scope section" and the lookup falls back to THIS section -- a scopes_sect entry would never be
; reached. Same reason the lens factor keys are here (Weapon.cpp:2985 checks cNameSect()).
need_lens_frame         = true
; NOT the magnification you see: the lens squeezes its whole capture into the disc of the ocular MESH,
; so the screen gets factor x that disc's share of screen height (scope_2d_pip_match below).
; MEASURED in game against the alter (true 1x) sight: the lens stops magnifying at an effective 5.0,
; so the share is 1/5 = 0.2 -- which is the ocular window itself (2 x scope_nv_mask_radius 0.105),
; i.e. the mesh disc IS the glass here. 15 x 0.2 = 3.0x, and the flat 2D scope lands on the same
; figure: both are computed from this one number.
scope_lens_factor       = 15.0	; orig 1.8, then 8.0/48/14.29 while calibrating ; lens image magnification
min_lens_factor         = 15.0	; orig 1.8
max_lens_factor         = 15.0	; orig 1.8
lens_factor_levels_count = 1		; fixed magnification, no zoom steps
default_lens_factor_step = 0
zoom_mouse_sense_koef   = 0.3	; orig 0.5 ; unused while the eyepiece magnifies -- AimSenseScale takes the real 3.0x (1/3 = 0.33)
scope_nv_mask_radius    = 0.112	; orig 0.105 ; the G36's glass: a small window in a big body, measured off
								; the texture (the stock optics sit at ~0.26 of screen height)
; How long after the aim rotation the 2D picture waits (and the weapon goes away with it).
; Engine default 0.04 -- this optic is built in and comes to the eye slower, so it holds on longer.
scope_2d_show_delay     = 0.1
; What the 3D lens ACTUALLY shows, as a share of scope_lens_factor (see above). 0.2 measured in game;
; the engine default -- 2 x scope_nv_mask_radius, the glass diameter -- would give 0.21, so this key
; only trims that by five per cent and could be dropped if the two ever need to stay in step.
scope_2d_pip_match      = 0.2
scope_abberation        = 0.005

