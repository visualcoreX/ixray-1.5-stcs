; ---- misc ----
; GS shotguns/bm16/huds.ltx: the double-barrels author the gesture per loaded shell (anm_suicide_1/_2,
; no plain anm_suicide), so these two flags were missed by the flag sweep and the engine treated the
; weapon as having no suicide animation at all -- it went down the hud-offset path meant for launchers.
prohibit_suicide = false
suicide_by_animation = true
hud_move_suicide_offset_pos = 0, 0, 0
hud_move_suicide_offset_rot = 0, 0, 0
hud_move_suicide_offset_pos_16x9 = 0, 0, 0
hud_move_suicide_offset_rot_16x9 = 0, 0, 0
anm_suicide_1 = toz66_suicide, idle_1
anm_stop_suicide_1 = toz66_suicide_end, idle_1
anm_suicide_2 = toz66_suicide
anm_stop_suicide_2 = toz66_suicide_end

; ---- GS controller-suicide animation block (verbatim from GS shotguns/bm16/huds.ltx). The alias
; alone is not enough: without lock_time_anm_suicide the engine uses a hardcoded 3 s and the
; shot lands in the middle of the gesture. ----
custom_suicide_shot                = true
lock_time_anm_suicide_1            = 7.37
lock_time_anm_stop_suicide_1       = 1.37
lock_time_anm_suicide_2            = 7.37
lock_time_anm_stop_suicide_2       = 1.37
suicide_delay                      = 0.25

