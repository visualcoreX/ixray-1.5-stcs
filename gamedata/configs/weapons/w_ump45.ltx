; ============================================================================
; HK UMP45 -- Gunslinger port (GS smg\mp5\uniq.ltx). Own world/hud models (wpn_ump45),
; hud anims come from the shared mp5 omfs. .45 ACP, semi only, its own 16-node tree
; (upgrades\w_ump45_up.ltx) incl. a screw-on silencer node.
; wpn_mp5_nimble = the same gun as a unique (star overlay on the inventory icon).
; Torch geometry is inherited from wpn_mp5 ([mp5_flashlight]); the laser uses its own
; [ump45_laser] (same bones, different dot offsets).
; ============================================================================
[wpn_ump45]:wpn_mp5
bullet_material				= objects\bullet_automatic	; wallmark/impact/ricochet pair on hit
$spawn                  = "weapons\wpn_mp5_nimble"		; option for Level Editor
inv_name		= gunsl_wpn_ump45
description		= gunsl_wpn_ump45_descr

cost                    = 5500

hit_power		= 0.85, 0.85, 0.85, 0.85
inv_weight        = 2.45
fire_dispersion_base    = 0.26
rpm                     = 600

ammo_elapsed      = 26
ammo_mag_size     = 26          

ammo_class		= ammo_11.43x23_fmj, ammo_11.43x23_hydro
fire_modes		= 1, -1

flame_particles		   		= ghost_particles\weapons\smoke_9mm_pistol
smoke_particles		   		= ghost_particles\weapons\smoke_9mm_stock_smg
silencer_smoke_particles 	= ghost_particles\weapons\suppressor_smoke_pistol_common

upgrades = vartree_ump45_mag_fix, vartree_ump45_zatvor, vartree_ump45_rail, vartree_ump45_handle, vartree_ump45_sights, vartree_ump45_stock, vartree_ump45_sil
installed_upgrades = 
upgrade_scheme = upgrade_scheme_ump45
allowed_upgrades = up_ump45_

inv_grid_width    = 4
inv_grid_height   = 2
; raw rect = the shared EMPTY slot; the gun itself is drawn by element_icon_0 below, so the
; upgrade overlays (rail / handle / torch) and the unique star can compose on top of it.
inv_grid_x        = 21	; orig 6 (GS)
inv_grid_y        = 0	; orig 39 (GS)

element_icon_0 = icon_element_ump45_body	; GS art at 6,39
element_icon_offset_x_0 = 0
element_icon_offset_y_0 = 0
; clear the mp5 part layers inherited from the parent section
element_icon_1 =
element_icon_2 =
element_icon_3 =

upgr_icon_x		= 1684
upgr_icon_y		= 121
upgr_icon_width		= 233
upgr_icon_height   	= 128

visual                  = dynamics\weapons\wpn_ump45\wpn_ump45.ogf

snd_shoot		= weapons\ump45\ump45_shoot, -1.1
snd_reload		= weapons\ump45\ump45_reload
snd_reload_empty        = weapons\ump45\ump45_reload_empty
snd_changecartridgetype = weapons\ump45\ump45_reload

hud                     = wpn_ump45_hud

; own laser params (the UMP's LAM sits differently than the mp5's): [ump45_laser] below inherits
; [mp5_laser] and overrides only the dot offsets. Without THIS line the weapon keeps mp5_laser,
; because laser_params_section is inherited from wpn_mp5.
laser_params_section    = ump45_laser

wanm_idle_empty = idle_empty
wanm_idle_empty_a = idle_empty_auto

wanm_shoot_last = shoot_last
wanm_shoot_last_a = shoot_last_auto

[wpn_ump45_hud_general]

