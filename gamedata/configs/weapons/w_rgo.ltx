;---------------------- Suicide -------------------------
; мощность броска из взведенного состояния (то есть когда игрок вытащил чеку, поднял руку с греной и пошел к контре; отыграется обычный бросок)
suicide_ready_force = 2  

; мощность броска в случае доведения контролером дела до конца
suicide_success_force = 1
;задержка между броском после успеха самоубийства и взрывом (ставить по минимуму)
suicide_success_destroy_time = 200


; мощность броска грены, когда актор ушел от контры и отбрасывает грену в сторону
suicide_fail_force = 20
; время от начала отбрасывания до взрыва
suicide_fail_destroy_time = 700

snd_suicide_begin = weapons\grenade\suicide_f1_start
snd_suicide_throw = weapons\grenade\grenade_throw
snd_suicide_stop = weapons\grenade\grenade_throw

