misfire_end_prob        = 0.0
condition_queue_shot_dec= 0.00002
snd_breechblock         = $silent
crosshair_inertion      = 10
repair_group            = rpg7
scopes_sect             = scope_pgo7v_rpg7
; scope OFF -> `mount` visible, `mount_off` hidden; scope ON -> the reverse (the scope section shows
; mount_off + scope1 and its overriding_hide_bones takes `mount` away). These defaults are what makes
; the OFF state right: our per-scope hide only runs while the optic is attached, so `mount` needs a
; def_show to come back on detach, and `mount_off`/`scope1`/`metka1` need a def_hide to start off.
def_show_bones          = mount
def_hide_bones          = mount_off, scope1, metka1
; InitAddons reads these from the WEAPON section with fatal r_string/r_s32 as soon as scope_status = 2,
; even on a multi-scope weapon (the per-scope section only overrides them). Values = GS scopes.ltx.
scope_name              = wpn_addon_scope_pgo7v	; default/fallback scope item
scope_x                 = 135	; offset in the inventory icon
scope_y                 = 11
; reticle-brightness clicks (GS base.ltx:202-203) -- read from the WEAPON section, not the scope one
snd_scope_brightness_plus  = weapons\nv_intensity
snd_scope_brightness_minus = weapons\nv_intensity

; ---- GS backblast + rocket malfunction (heavy/rpg-7/base.ltx:48-66) ----
