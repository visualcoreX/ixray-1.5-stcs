reactive_hit_power			= 0.7
reactive_hit_impulse		= 200
reactive_hit_buck			= 10
reactive_hit_buck_disp		= 0.3
reactive_hit_type			= 7		; explosion -- orig 8, which is GS's number for it; ours is 7
reactive_hit_bullet_material = default
reactive_hit_reverse_k		= 0.5
reactive_hit_reverse_disp	= 0.1
reactive_hit_reverse_disp2	= 0.3
reactive_hit_reverse_buck	= 3
reactive_hit_reverse_power	= 0.25
