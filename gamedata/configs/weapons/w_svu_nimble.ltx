; ============================================================================
; SVU, GS's unique variant (sniper/svu/uniq.ltx) -- single-fire, 10-round mag,
; its own 21-node tree. Visual/hud/scopes/element icons inherited from [wpn_svu].
; ============================================================================
[wpn_svu_nimble]:wpn_svu
$spawn              = "weapons\wpn_svu_nimble"
inv_name				= gunsl_wpn_svu_nimble
description				= gunsl_wpn_svu_nimble_descr

def_hide_bones = ironsight_off, scope1, scope2, scope3, scope4, scope5, mag20, handler2, sight_on, sight_off, sheka
def_show_bones = ironsight_on, mag10, firemode, handler

upgrades = vartree_wpn_svu_nimble_sights, vartree_wpn_svu_nimble_prujina, vartree_wpn_svu_nimble_tsevie_rezina, vartree_wpn_svu_nimble_handle, vartree_wpn_svu_nimble_sheka, vartree_wpn_svu_nimble_priklad
installed_upgrades =
upgrade_scheme = upgrade_scheme_wpn_svu_nimble
allowed_upgrades = up_wpn_svu_nimble_

cost                    = 22000

rpm                     = 600
singleshoots_time_delta = 0.25
fire_modes		= 1, -1
cam_return              = 1

uniq_icon = upgrade_addon_icon_uniq_item
uniq_icon_offset_x = 200
uniq_icon_offset_y = 50

;---дисперсия-------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base    = 0.12   ;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
control_inertion_factor = 1.6f

zoom_cam_step_angle_horz    = 1.5

fire_dispersion_condition_factor = 10	;увеличение дисперсии в процентах при максимальном износе
