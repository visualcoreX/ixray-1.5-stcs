; ============================ PMM (GS uniq variant of the PM) ============================
; GS keeps it in pistols/pm/uniq.ltx as [wpn_pm_actor]: same skeleton, same OMFs (both wpn_pmm.ogf
; and wpn_pmm_hud.ogf reference wpn_pm_animation / wpn_pm_hud_animation), reinforced frame, heavier
; slide, 12-round magazine. Everything below is GS's PMM DELTA over GS's PM, applied to OUR PM --
; our base already carries GS's PM numbers everywhere the delta touches, except weight, cost and the
; silencer offsets, which are ours.
[wpn_pmm]:wpn_pm
$spawn                  	= "weapons\pmm"		; option for Level Editor
visual                  	= dynamics\weapons\wpn_pm\wpn_pmm.ogf
hud                     	= wpn_pmm_hud

description			= gunsl_wpn_pmm_descr
inv_name			= gunsl_wpn_pmm
inv_name_short		= gunsl_wpn_pmm

upgrades                = vartree_wpn_pmm_barrel, vartree_wpn_pmm_mag, vartree_wpn_pmm_sights
installed_upgrades      =
upgrade_scheme          = upgrade_scheme_wpn_pmm
allowed_upgrades        = up_wpn_pmm_

cost					= 450	; GS prices the PMM at 1.5x its PM; ours is 300, not GS's 400
inv_weight				= 0.53	; +0.03 over our PM, same step GS takes

; 12 in the magazine + the one in the chamber (ammo_in_chamber is on for the whole family)
ammo_mag_size		 	= 13
ammo_elapsed		 	= 13

hit_power           		= 0.95, 0.95, 0.95, 0.95
bullet_speed		 	= 160

fire_dispersion_base	= 0.22
cam_dispersion          = 0.65
cam_dispersion_inc		= 0.75

PDM_disp_base 				= 1.3
PDM_disp_vel_factor 		= 1.1
PDM_disp_crouch	 			= 0.85

zoom_cam_dispersion         = 0.26
zoom_cam_dispersion_inc     = 0.7
zoom_cam_max_angle          = 25.0

; wears slower than the PM, but starts misbehaving from a higher condition once it does
misfire_start_condition		= 0.7
misfire_end_condition		= 0.2
misfire_start_prob	     	= 0.01
misfire_end_prob	     	= 0.055
condition_shot_dec      	= 0.0025
condition_queue_shot_dec	= 0.003
; our light-strike model mirrors the misfire thresholds, exactly as it does on [wpn_pm]
light_misfire_start_condition = 0.7
light_misfire_end_condition = 0.2

silencer_x 					= 60	; our PM sits at 58; GS shifts its PMM +2 over its PM

; inv icon: GS's PMM art, already sitting in our atlas at GS's own coordinates
inv_grid_width			= 2
inv_grid_height	        = 1
inv_grid_x				= 16
inv_grid_y				= 26
; MUST override the inherited element_icon_0 -- it points at the PM's rect and would be drawn over
; the PMM icon (the same trap the APB hit over the stechkin)
element_icon_0 = icon_element_wpn_pmm_base
element_icon_offset_x_0 = 0
element_icon_offset_y_0 = 0

uniq_icon = upgrade_addon_icon_uniq_item
uniq_icon_offset_x = 50
uniq_icon_offset_y = 0

[icon_element_wpn_pmm_base]	; = the weapon's own inv icon (base layer for the silencer overlay)
inv_grid_width  = 2
inv_grid_height = 1
inv_grid_x      = 16
inv_grid_y      = 26

[wpn_pmm_hud]:wpn_pm_hud
item_visual             	= dynamics\weapons\wpn_pm\wpn_pmm_hud.ogf

