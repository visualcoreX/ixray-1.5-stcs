; GS: a grenade cooks off when it is damaged, including while it is just lying in the world.
; 8 = fire_wound (a bullet), 7 = explosion (another blast sets it off) -- OUR numbering;
; GS writes `6, 8` for the same two, its EHitType enum is the SoC one and is ordered differently.
; explosive_while_not_activated is what allows it
; before the grenade has been thrown.
explosion_on_hit = true
explosion_hit_types = 8, 7	; orig GS `6, 8` = fire_wound + explosion; OUR enum spells those 8 and 7
explosive_while_not_activated = true

detonation_threshold_hit = 0.4	; orig 200 (set at the top of the section; the later line wins)

; GS quick throw: the quick_grenade key pulls and lobs in one motion (anm_throw_quick).
supports_quick_throw = true
