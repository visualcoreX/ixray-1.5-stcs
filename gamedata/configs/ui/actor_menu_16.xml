  <!-- Slot condition bars (GSC / Call of Pripyat mechanism). Owned by the menu, not by the cell in
       the slot: a cell-owned bar is clipped away by the list container's scissor the moment it
       reaches the frame's edge. Sprite: the FULL 58px status bar in ui_actor_menu_cop.dds (the cell
       bar in the inventory uses cropped 30/38px slices of the same strip, and keeps them).
       Positions came measured on ui_ingame2_common.dds as CENTRE + size, so: top-left = centre minus
       half the size, then X and WIDTH times 604/725 (the menu's texture scale, same as the slot
       frames), Y and HEIGHT as measured. centres: weapon1 549,367 | weapon2 602,285 | outfit 496,285
       -- each lands the bar centred in its slot, flush with the bottom of the frame.              -->
  <progess_bar_weapon1 x="433.21" y="364.5" width="48.32" height="5" horz="1" min="0" max="1" pos="1">
    <background x="0" y="0" width="48.32" height="5" stretch="1">
      <texture r="62" g="74" b="74">ui_inGame2_inventory_status_bar_cop</texture>
    </background>
    <progress stretch="1">
      <texture r="142" g="149" b="149">ui_inGame2_inventory_status_bar_cop</texture>
    </progress>
    <min_color r="196" g="18" b="18"/>
    <middle_color r="255" g="255" b="118"/>
    <max_color r="107" g="207" b="119"/>
  </progess_bar_weapon1>

  <progess_bar_weapon2 x="477.37" y="283" width="48.32" height="5" horz="1" min="0" max="1" pos="1">
    <background x="0" y="0" width="48.32" height="5" stretch="1">
      <texture r="62" g="74" b="74">ui_inGame2_inventory_status_bar_cop</texture>
    </background>
    <progress stretch="1">
      <texture r="142" g="149" b="149">ui_inGame2_inventory_status_bar_cop</texture>
    </progress>
    <min_color r="196" g="18" b="18"/>
    <middle_color r="255" g="255" b="118"/>
    <max_color r="107" g="207" b="119"/>
  </progess_bar_weapon2>

  <progess_bar_outfit x="389.06" y="283" width="48.32" height="5" horz="1" min="0" max="1" pos="1">
