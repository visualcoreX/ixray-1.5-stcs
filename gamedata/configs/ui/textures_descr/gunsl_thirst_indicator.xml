<w>
	<!-- Thirst indicator glyph, drawn by gunsl_thirst.script next to the engine's state icons.
	     Hand-made and placed in the hud atlas, same 22x22 as the rad/fire/acid/psi/food glyphs.
	     One texture for all four states: the script tints it (green -> yellow -> orange -> red)
	     instead of swapping textures, which is what GS does with four separate images. -->
	<!-- x/y are the TOP-LEFT corner of the cell, not its centre: the glyph occupies 995..1016 by
	     855..876 in the atlas. (1006,866) is its middle, and with width 22 it would also have run
	     4 px past the 1024 edge of the texture. -->
	<file name="ui\ui_hud">
		<texture id="ui_gunsl_thirst_indicator" x="995" y="855" width="22" height="22" />
	</file>
</w>
