    </auto_static>
    <!-- The two black side fillers: inner edges flush with the picture, outer ones far off the
       canvas on purpose. On a display wider than 16:9 the whole scope window is drawn narrower
       than the screen so the optic keeps its shape, and these have to cover what is left of the
       width -- how much that is depends on the monitor, so they simply overshoot. -->
    <auto_static x="-2000" y="0" width="2087" height="768" stretch="1">
