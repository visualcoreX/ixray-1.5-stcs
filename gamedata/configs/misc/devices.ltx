description             = enc_weapons1_wpn_flare

inv_weight				= 0.2
inv_name				= device_flare
inv_name_short			= device_flare_short

inv_grid_width				= 2
inv_grid_height				= 1
inv_grid_x					= 12
inv_grid_y					= 7

