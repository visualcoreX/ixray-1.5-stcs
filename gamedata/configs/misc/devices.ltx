; ------------------------------------------------------------------------------------------------
; A dead Veles: full copy of detector_elite that finds nothing and shows nothing on its screen.
; NOT inherited from detector_elite ON PURPOSE. LTX cannot UNSET an inherited key, and the elite
; chain carries af_class_1..23; CDetectList::load walks af_class_<n> until one is missing, so
; inheriting them would make this thing detect. Built off identity_immunities exactly like
; detector_torch, with every key of the RESOLVED detector_elite section copied over except the
; af_class / af_sound / af_freq family. There is no parent to fall back on -- when editing, add
; keys here rather than expecting them to be inherited.
[detector_elite_broken]:identity_immunities
GroupControlSection		= spawn_group
$spawn 					= "devices\detector_elite_broken"
$prefetch 				= 32
class					= D_ELITE
cform					= skeleton
visual					= dynamics\devices\dev_detector_3\dev_detector_3_broken.ogf

hud						= detector_elite_broken_hud
animation_slot			= 7

inv_name				= st_detector3_broken
inv_name_short			= st_detector3_broken
description				= st_detector3_broken_descr

slot					= 8
ef_detector_type		= 1
inv_weight				= 0
sprint_allowed			= true
control_inertion_factor	= 1.0
zoom_rotate_time		= 0.25

inv_grid_width			= 1
inv_grid_height			= 1
inv_grid_x				= 5
inv_grid_y				= 14
cost					= 200
default_to_ruck			= false

; CCustomDetector::Load reads both unguarded, so they must exist even though nothing is detected
af_radius				= 30
af_vis_radius			= 5

; the elite screen overlay -- radar background AND artefact marks. The marks would stay away by
; themselves (nothing is ever detected), the radar would not. CEliteDetector::render_item_3d_ui_query
draw_af_ui				= false

; CUIArtefactDetectorElite::construct reads both unguarded, overlay off or not
ui_p					= -0.049,-0.0665,0.0115
ui_r					= 0,0,0

attach_position_offset	= 0.110,-0.019,0.008
attach_angle_offset		= -1.603,-0.813,-1.802
attach_bone_name		= bip01_l_hand
auto_attach				= false

snd_draw				= detectorshud\detector_draw
snd_holster				= detectorshud\detector_hide

; the hud section CAN inherit -- af_class_* lives on the item, not here, so all 195 animation
; aliases of the working veles come along for free
[detector_elite_broken_hud]:detector_elite_hud
item_visual				= dynamics\devices\dev_detector_3\dev_detector_3_broken_hud
