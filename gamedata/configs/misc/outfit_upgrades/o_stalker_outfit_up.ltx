;-- ARMOUR STEPS ------------------------------------------------------------------------
; Three suits share this tree with the stalker suit but sit higher on the armour ladder, so its
; steps (light_armor_1/2 = 0.15/0.30) either lowered their bullet resistance or left it where it
; was -- in the upgrade window the number never moved. Each gets ONE step of its own instead.
; Everything else is inherited from the stalker nodes: same cost, weight, icons, functors and
; scheme_index, so only the value changes. `effects` is deliberately empty -- there is no second
; tier any more, and the freed cell is skipped by the upgrade window (engine ab8f80e3).

; monolith_outfit: base actor_medium_armor 0.30 -> 0.45
[up_gr_ab_monolith_outfit]
elements		= up_a_monolith_outfit, up_b_monolith_outfit

[up_a_monolith_outfit]:up_a_stalker_outfit
effects			=
section			= up_sect_a_monolith_outfit

[up_sect_a_monolith_outfit]:up_sect_a_stalker_outfit
bones_koeff_protection		= actor_medium_armor_1

; ...and its own `c` as well: the second-tier armour node up_ac_stalker_outfit is unlocked by
; BOTH branches (a AND c -- that is what the name means), so leaving the shared `c` in place
; would keep the removed step reachable through the damage branch.
[up_gr_cd_monolith_outfit]
elements		= up_c_monolith_outfit, up_d_monolith_outfit

[up_c_monolith_outfit]:up_c_stalker_outfit
effects			= 

; killer_outfit: base actor_light_armor_1 0.15 -> 0.30
[up_gr_ab_killer_outfit]
elements		= up_a_killer_outfit, up_b_killer_outfit

[up_a_killer_outfit]:up_a_stalker_outfit
effects			=
section			= up_sect_a_killer_outfit

[up_sect_a_killer_outfit]:up_sect_a_stalker_outfit
bones_koeff_protection		= actor_light_armor_2

; ...and its own `c` as well: the second-tier armour node up_ac_stalker_outfit is unlocked by
; BOTH branches (a AND c -- that is what the name means), so leaving the shared `c` in place
; would keep the removed step reachable through the damage branch.
