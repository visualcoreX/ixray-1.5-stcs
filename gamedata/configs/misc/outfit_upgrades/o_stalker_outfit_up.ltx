[up_c_svoboda_warrior_outfit]:up_c_stalker_outfit
effects			= 

;-- ONE-ARMOUR-STEP VARIANT ---------------------------------------------------------------------
; Shared by the three suits whose armour branch has a single step (monolith / killer /
; svoboda_warrior). Removing the second armour node freed cell <1,0> of upgrade_scheme_u15a, and a
; scheme cell with no upgrade behind it crashes the upgrade window -- it walks every cell of the
; scheme, not just the filled ones. So these suits use upgrade_scheme_u15a_1arm, whose second column
; is one cell shorter, and the four second-tier nodes move up one index to match. Their screen
; positions are unchanged: the template simply drops the cell the armour tier 2 used to occupy.
; Everything is inherited from the stalker nodes -- same sections, same cost, same icons, so the
; mechanic gates (keyed on up_sect_*) keep working untouched.

[up_eg_1arm]:up_eg_stalker_outfit
scheme_index		= 1, 1

[up_fh_1arm]:up_fh_stalker_outfit
scheme_index		= 1, 2

[up_i2_1arm]:up_i2_stalker_outfit
scheme_index		= 1, 3
effects			= up_gr_i3_1arm

[up_gr_eg_1arm]
elements		= up_eg_1arm

[up_gr_fh_1arm]
elements		= up_fh_1arm

[up_gr_i2_1arm]
elements		= up_i2_1arm

; first tier: only the group each one unlocks changes
[up_e_1arm]:up_e_stalker_outfit
effects			= up_gr_eg_1arm

[up_f_1arm]:up_f_stalker_outfit
effects			= up_gr_fh_1arm

[up_g_1arm]:up_g_stalker_outfit
effects			= up_gr_eg_1arm

[up_h_1arm]:up_h_stalker_outfit
effects			= up_gr_fh_1arm

[up_i_1arm]:up_i_stalker_outfit
effects			= up_gr_i2_1arm

[up_gr_ef_1arm]
elements		= up_e_1arm, up_f_1arm

[up_gr_gh_1arm]
elements		= up_g_1arm, up_h_1arm

[up_gr_i_1arm]
elements		= up_i_1arm

; ...and its own third tier. Pointing at up_gr_i3_stalker_outfit would have given THAT
; group a second parent group, and with require_all_parent_groups (the default) the stalker
; suit would then need an upgrade it cannot have -- that is what locked the artefact
