; task: the headlamp's HUD twin spot that lights the first-person hands/weapon, in CAMERA space
; (x=right, y=up, z=forward). Placed ABOVE the eye like a helmet lamp so the specular blik falls on the hands
; from above (as in GS) and they drop out of the beam when you look up. torch_hands_hud_cone (deg, <=0 = same
; as the world spot) narrows the beam so that pitch-out happens sooner. Tune both here, no rebuild.
torch_hands_hud_offset	= 0.0, 0.12, 0.0
torch_hands_hud_cone	= 0
; GS "light sphere": a hud point light co-located with the hud spot -> crisp view-dependent specular blik on
; the hands. Small range = tight local highlight. Raise for a broader glow on the hands.
torch_hands_hud_omni_range	= 1.0

; spot cone texture override. GS's headlamp uses the STANDARD texture (the tactical ones are for the WEAPON
; flashlight [tactical_torch] and the handheld detector torch), so we leave this OFF -> the stock texture
; baked in dev_torch_light.ogf is used. Uncomment to force a different one.
; torch_spot_texture		= internal\internal_light_torch_r2

attach_angle_offset		= 3.062, 0.008, -1.532
attach_position_offset		= 0.134, -0.007, 0.09

attach_bone_name		= bip01_head
auto_attach			= false

night_vision				= on
night_vision_texture		= wpn\wpn_night
night_vision_effector		= postprocess_night

snd_night_vision_on			= weapons\nv_start
snd_night_vision_off		= weapons\nv_off
snd_night_vision_idle		= weapons\nv_loop
snd_night_vision_broken		= weapons\nv_off

