night_vision_recharge_time_min		= 2		;(c) ���. ����� ������� ������������, ����� �������� ���-�� ��� ����� ��������
night_vision_discharge_time			= 20	;(c) ����� �������� (������) ���������� ����� ������ �������
slot								= 9
