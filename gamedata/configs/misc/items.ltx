; eatable item -- effects moved to [vodka_eatable] (usable_items\vodka\eatable_objects.ltx) so the
; animated use applies them after effect_delay instead of instantly. Real values zeroed here.
eat_health		= 0
eat_satiety		= 0
eat_power		= 0
eat_radiation	= 0
eat_alcohol		= 0
wounds_heal_perc = 0
eat_portions_num = -1

; food item
slot				= -1
animation_slot		= 4

;hud item
hud = vodka_hud_model

; --- multi-use chain (GS): four sips, each stage an inventory section of its own ------------
; gwr_eatable walks base_object/uses_count/using_N and spawns the next stage once the sip has
; really landed, so an interrupted animation cannot drink one. The quick-use key follows the
; same chain (quick_use_item, ActorInput.cpp) -- the slot stores `vodka` but the bag holds
; `vodka2` after the first swig.
base_object         = vodka
uses_count          = 4
using_2             = vodka2
using_3             = vodka3
using_4             = vodka4
; how full the bottle is drawn in the inventory cell -- the same bar the weapons use for wear
visual_condition    = 1.0

break_particles		= destroy_fx\destroy_bottle
break_sound			= material\bottle\collide\bottle_break_1

; Partly drunk bottles. Everything but the icon, weight, price and description is inherited;
; `hud` picks the phantom that plays the sip (usable_items\vodka\hud_objects.ltx), and the last
; stage throws the empty away instead of leaving a bottle behind.
[vodka2]:vodka
description         = gunsl_eatable_vodka_descr2
hud                 = vodka_hud_model2
inv_weight          = 0.17
cost                = 60
inv_grid_x          = 34
inv_grid_y          = 39
visual_condition    = 0.75

[vodka3]:vodka
description         = gunsl_eatable_vodka_descr3
hud                 = vodka_hud_model3
inv_weight          = 0.13
cost                = 35
inv_grid_x          = 35
inv_grid_y          = 39
visual_condition    = 0.5

[vodka4]:vodka
description         = gunsl_eatable_vodka_descr4
hud                 = vodka_hud_model4
inv_weight          = 0.1
cost                = 10
inv_grid_x          = 36
inv_grid_y          = 39
visual_condition    = 0.25

; A second bottle for the same drink -- different model only. Values, price, weight, icon and
; effects are inherited stage by stage from the plain vodka above, so the two can never drift
; apart; the world/hud models, the icon and the chain links are all that is overridden.
; ONE icon for all four stages -- there is no per-stage art for this bottle.

