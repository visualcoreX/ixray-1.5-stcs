[esc_quest_akm47]:wpn_ak74
$spawn 				= "quest_items\esc_quest_akm_47"
description			= st_esc_quest_akm47_descr
inv_name          		= st_esc_quest_akm47
inv_name_short    		= st_esc_quest_akm47
ammo_class			= ammo_7.62x39_fmj
reload_drop_bones	= mag30:mag_drop_akm_30	; its own magazine (wpn_ak74's list would drop a 5.45 one); the frame, speed and the rest are wpn_ak74's
; No upgrades and no addons on this one. The upgrade keys are blanked rather than inherited from
; wpn_ak74 (which carries the seven vartree_ak74_* branches and upgrade_scheme_ak74); the three
; addon slots have to be closed explicitly, because wpn_ak74 sets them all to 2 = attachable.
upgrades            		=
installed_upgrades  		=
upgrade_scheme      		=
scope_status			= 0	; orig inherited 2
silencer_status			= 0	; orig inherited 2
grenade_launcher_status		= 0	; orig inherited 2
fire_dispersion_base 		= 0.305	; half the ACCURACY of wpn_ak74: (0.42-0.19)/0.42 = 55%, half is 27% -> fdb 0.305. orig 0.5
hit_power            		= 0.8, 0.8, 0.8, 0.8	; back to the original on request; was 1.055 (damage bar 65%, wpn_ak74 1.0 = 57%)
can_trade			= false

; Twice the recoil of wpn_ak74. Only the per-shot kick is doubled: cam_relax_speed is the RETURN
; speed (doubling it would soften the recoil, not raise it), cam_dispersion_frac is a ratio, and
; the cam_max_angle* pair is the ceiling the accumulated rise stops at -- with the kick doubled the
; gun simply reaches that same ceiling in half the shots.
cam_dispersion              = 1.6	; wpn_ak74 0.8
cam_dispersion_inc          = 1.0	; wpn_ak74 0.5
cam_step_angle_horz         = 0.7	; wpn_ak74 0.35
zoom_cam_dispersion         = 1.2	; wpn_ak74 0.45
zoom_cam_dispersion_inc     = 1.0	; wpn_ak74 0.45
zoom_cam_step_angle_horz    = 0.8	; wpn_ak74 0.3
visual                  = dynamics\weapons\wpn_akm\wpn_akm.ogf

snd_shoot                = weapons\ak74\ak74_shoot_01, -0.9
snd_shoot1               = weapons\ak74\ak74_shoot_02, -0.9
snd_shoot2               = weapons\ak74\ak74_shoot_03, -0.9
snd_shoot3               = weapons\ak74\ak74_shoot_04, -0.9
snd_shoot4               = weapons\ak74\ak74_shoot_05, -0.9
snd_shoot5               = weapons\ak74\ak74_shoot_06, -0.9
snd_shoot6               = weapons\ak74\ak74_shoot_07, -0.9
snd_shoot7               = weapons\ak74\ak74_shoot_08, -0.9
snd_shoot8               = weapons\ak74\ak74_shoot_09, -0.9
snd_shoot9               = weapons\ak74\ak74_shoot_10, -0.9
snd_shoot10               = weapons\ak74\ak74_shoot_11, -0.9
snd_shoot11               = weapons\ak74\ak74_shoot_12, -0.9

hud				= esc_quest_akm47_hud
element_icon_0 = icon_element_akm_body
element_icon_1 = icon_element_mag
; Gunslinger unique marker: bottom-right cell of the 5x2 grid inherited from wpn_ak74,
; i.e. (5-1)*50 and (2-1)*50. Needs element_icon_0 above to exist, which it does.
uniq_icon = upgrade_addon_icon_uniq_item
uniq_icon_offset_x = 200
uniq_icon_offset_y = 50

flame_particles		   	= ghost_particles\weapons\flame_762x39_akm
smoke_particles			= ghost_particles\weapons\smoke_762x39_akm

[icon_element_akm_body]
inv_grid_width     = 5
inv_grid_height    = 2
inv_grid_x         = 0
inv_grid_y         = 30
[icon_element_mag]
inv_grid_width      = 1
inv_grid_height     = 1
inv_grid_x          = 20
inv_grid_y          = 0

; AKM model in the hands instead of the inherited AK-74 one. The .ogf carries a motion-ref to
