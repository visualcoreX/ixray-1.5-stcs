#include "common.h"
#include "collim.h"

// Pass 3 of a collimator's glass (models_lenses.s l_special), the distortion mask pass
// (r_dsgraph_render_lens_undistort): draws nothing. The world behind the glass ripples as the world around, and
// the reticle's glow is laid on only after the distortion, in the late pass (model_collim_late.ps), so it stays put.
float4 main( v2p_collim I ) : SV_Target
{
	clip( -1 );
	return	0;
}
