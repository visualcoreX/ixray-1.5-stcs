#include "common.h"
#include "lmodel.h"

#ifdef USE_MINMAX_SM
#define SM_MINMAX
#endif

#if SUN_QUALITY>2
#define ULTRA_SHADOWS_ON
#endif //	SUN_QUALITY>2

#ifdef ULTRA_SHADOWS_ON
#define USE_ULTRA_SHADOWS
#endif

#include "shadow.h"
uniform float3	view_shadow_proj;

//	Cascade cross-fade. Each cascade covers a box of the world in light space; where two of them meet,
//	the shadow map is suddenly stretched over a much larger area. The stencil used to let exactly one
//	cascade light each pixel, so that was a hard step. Now a cascade takes a_own of what the earlier
//	ones left over -- a product, see R_sun.cpp -- over a band at the edge of its box. Close to the
//	player the band closes up and the edge stays a hard cut (the near box is slid forward, so that is
//	mostly the edge behind him), further out it opens to its full width.
uniform float4x4	m_shadow_prev;		//	the previous cascade's box, for its weight (no per-pass depth tweaks)
uniform float4x4	m_shadow_prev2;		//	 ... and for the one before that
uniform float4		cascade_zband;		//	the band along the sunlight, in each box's depth units: x own, y previous, w the one before
uniform float4		cascade_blend;		//	x: own band, y: previous cascade's, z: has a previous one,
										//	w: band of the one before that, 0 if there is none

//	1 inside the cascade's box, 0 outside it, sliding to 0 over the last `band` of the box at an edge.
//	The band is narrowed by how far the PIXEL is from the camera, in metres (P4 is in view space):
//	nearer than band_near it is a hard cut, past 2*band_near the whole band. Measured in the world, not
//	in the shadow map: in the map a raised camera slides along the sunlight and an edge ten metres off
//	on the ground looked "next to the player". Not tied to where you look either. Every pass computes
//	the same number for a pixel, so the weights still add up to 1. The z test keeps this in step with
//	the volume actually rasterised (`corners` in accum_direct_cascade -- only the 0.7..1 slice of the
//	box is drawn), so a cascade never claims a pixel it did not light.
float cascade_weight( float4x4 M, float4 P4, float band, float zband )
{
	const float	band_near	= 8.f;	//	the player's own surroundings keep the hard, stock cut -- behind him above all
	float4	PS	= mul( M, P4 );
	float3	p	= PS.xyz/PS.w;
	float	k	= saturate( ( length( P4.xyz ) - band_near )/band_near );
	float	b	= max( band * k, 1e-4f );
	float	bz	= max( zband * k, 1e-6f );	//	the far end of the box along the sunlight, see R_sun.cpp
	float2	bp	= b.xx;	//	the +x / +y edges
	float2	bn	= b.xx;	//	the -x / -y edges
	//	The weight stops a little INSIDE the box: a cascade lights only the pixels its box actually
	//	rasterises, and right on a face the rasteriser and this test can disagree by a pixel -- the
	//	weight said "mine" where no fragment came, and the sun left a hairline there. The margin goes
	//	to the next cascade (0.2% of the side across, ~1 m along the sun of a ~1.2 km deep box).
	const float	e_xy	= 0.002f;
	const float	e_z		= 0.001f;
	float2	f	= min( saturate( (1.f - e_xy - p.xy)/bp ), saturate( (p.xy - e_xy)/bn ) );
	return	min( f.x, f.y ) * step( 0.7f + e_z, p.z ) * saturate( (1.f - e_z - p.z)/bz );
}


#ifdef USE_SUNFILTER
#ifdef MSAA_OPTIMIZATION
float4 main ( v2p_volume I, uint iSample : SV_SAMPLEINDEX  ) : SV_Target
#else
float4 main ( v2p_volume I  ) : SV_Target
#endif
{
	//float4 _P = tex2D( s_position, tc );

	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc, I.hpos, ISAMPLE) );

#ifdef	GBUFFER_OPTIMIZATION
	//	Emulate virtual offset
	gbd.P += gbd.N*0.015f;
#endif	//	GBUFFER_OPTIMIZATION

	float4 _P = float4( gbd.P, 1.f);

	float4 PS = mul( m_shadow,  _P );

	float s	= shadowtest_sun( PS, I.tcJ ) * sunmask( _P );

	return s;
}
#else
#ifdef MSAA_OPTIMIZATION
float4 main ( v2p_volume I,  uint iSample : SV_SAMPLEINDEX ) : SV_Target
#else
float4 main ( v2p_volume I ) : SV_Target
#endif
{
	//float4 	_P	= tex2D( s_position, tc );
	//float4	_N	= tex2D( s_normal, tc );

	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc.xy/I.tc.w, I.hpos, ISAMPLE) );

#ifdef	GBUFFER_OPTIMIZATION
	//	Emulate virtual offset
	gbd.P += gbd.N*0.015f;
#endif	//	GBUFFER_OPTIMIZATION

	float4 _P = float4( gbd.P, gbd.mtl );
	float4  _N = float4( gbd.N, gbd.hemi );

  	float4 	P4 	= float4( _P.x, _P.y, _P.z, 1.f);
	float4 	PS	= mul( m_shadow, P4 );

	// ----- cascade weight (before anything expensive: most pixels belong to another cascade)
	// the last cascade takes whatever the tighter ones left over; both of them, the boxes are not nested
	float	w	= 1.f - cascade_weight( m_shadow_prev, P4, cascade_blend.y, cascade_zband.y );
	if ( cascade_blend.w > 0.f )
			w  *= 1.f - cascade_weight( m_shadow_prev2, P4, cascade_blend.w, cascade_zband.w );
	clip( w - 0.001f );

	// ----- light-model
	float	m	= xmaterial;
# ifndef USE_R2_STATIC_SUN
			m 	= _P.w;
# endif
	float4	light	= plight_infinity ( m, _P, _N, Ldynamic_dir );

	// ----- shadow
	float 	s 	= sunmask( P4 );
	#if defined	(USE_SJITTER) || SUN_QUALITY==2 // Hight quality
	  		s 	*= shadow_high(PS); //shadowtest_sun( PS, float4(0,0,0,0) );
	#else
#ifdef SM_MINMAX
		#ifdef USE_SJITTER
	  		s 	*= shadow_dx10_1( PS, I.tcJ, I.hpos.xy );
		#else
			s *= shadow( PS );
		#endif
#else
			s *= shadow( PS );
#endif
	#endif

	// Far edge fading code
	float2 	tc_f	= (PS.xy/PS.w)-float2(0.5f,0.5f);
			// Fade only fron edges
			tc_f 	*= step( -dot( tc_f, view_shadow_proj.xy ), 0 );
			tc_f	= abs( tc_f );
	float 	border 	= 0.4f;
	float 	fac_x 	= 1.f-saturate( ( tc_f.x - border )/(0.5f-border));
	float 	fac_y 	= 1.f-saturate( ( tc_f.y - border )/(0.5f-border));
	
	s += ((1-s)*(1-fac_x*fac_y));
	//\ Far edge fading code

	return 		blend( Ldynamic_color * light * s * w, I.tc );
}
#endif