#include "common.h"

uniform	float4 		m_affects;

struct 	v2p
{
 	float2 	tc0: 		TEXCOORD0;	// base
 	float3 	tc1: 		TEXCOORD1;	// environment
  	float4	c0:			COLOR0;		// sun.(fog*fog)
};

float get_noise(float2 co)
{
      return (frac(sin(dot(co.xy ,float2(12.9898,78.233))) * 43758.5453))*0.5;
};

Texture2D 	s_vp2;
Texture2D 	s_load;
float4 problems_main( v2p I )
{
	// ����� ������� ���������
	float problems = frac( timers.z * 5*(1 + 2 * m_affects.x) );	
	I.tc0.x+= ( m_affects.x > 0.09 && I.tc0.y > problems-0.01 && I.tc0.y < problems) ? sin((I.tc0.y-problems)*5*m_affects.y)  : 0;

	// ������� ������� ���������	
	problems = cos( ( frac( timers.z *2 ) - 0.5 ) * 3.1416 )*2 - 0.8;
	float AMPL = 0.13;
	I.tc0.x -= ( m_affects.x > 0.15 && I.tc0.y > problems-AMPL && I.tc0.y < problems+AMPL) ? cos(4.71*(I.tc0.y-problems)/AMPL) * sin( frac(timers.z)*6.2831*90 )  * 0.02 * (AMPL-abs(I.tc0.y-problems))/AMPL : 0;		
	
	// ������ �����-������ � ��������� ������
	I.tc0.x += ( m_affects.x > 0.38 ) ? (m_affects.y - 0.5) * 0.04 : 0;	
	
	// gwr: $user$ui holds the WHOLE captured screen, but pda_16.xml puts the device itself only at
	// x 85..939 of the 1024-wide UI space -- the rest is the two widescreen filler strips
	// (auto_static in <main>), which would eat ~17% of the glass. Crop to the device so it fills it.
	// The mesh being 4:3 (12.362 x 9.272) makes this exact: on 16:9 that rect renders 1.48:1, and
	// squeezing it onto the 4:3 glass lands at 1.333 -- what the 4:3 pda.xml was drawn at.
	// Only s_vp2 gets this; s_base is the model's own texture and must stay on the mesh UVs.
	// gwr: Y measured off the ui_pda2 texture itself (column x=512): the device's frame line
	// sits on row 32 at the top and 716 at the bottom, with an 8px black gap outside each.
	// The old start 0.0388 = row 29.8 left the top line right on the edge of the glass while
	// the bottom had ~12px of slack, so the top read as clipped. Settled at 0.0364 = row 28.0:
	// the outer edge of the gap (row 24) and its midpoint (row 27) both dropped the top too
	// far by eye. The END is deliberately unchanged (0.0364+0.9119=0.9483).
	float2	ui_tc	 = float2( 0.0915 + I.tc0.x * 0.8170, 0.0364 + I.tc0.y * 0.9119 );
	float4	t_vp2	 = (m_affects.x < 0.27) ? s_vp2.Sample	( smp_base, ui_tc) : s_base.Sample	( smp_base, I.tc0) ;
	
	// ��� ��� �������
	float noise	= get_noise(I.tc0*timers.z) *  m_affects.x * m_affects.x * 20;		
	t_vp2.r += noise;
	t_vp2.g += noise;
	t_vp2.b += noise;
	
	//���������� ������
	t_vp2.rgb = (m_affects.x > 0.41) ? 0 : t_vp2.rgb;
	
	return  float4	(t_vp2.r, t_vp2.g, t_vp2.b, 1);
}


float4 loading_main( v2p I )
{
	float4 t_load = s_load.Sample ( smp_base, I.tc0);
	return  float4	(t_load.r, t_load.g, t_load.b, 1);
}

float4 main( v2p I ) : SV_Target
{
	return (m_affects.a > 0 && m_affects.x >= 0.08 ) ? loading_main(I) : problems_main(I);
}