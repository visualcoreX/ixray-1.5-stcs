#include "common.h"
#include "lmodel.h"
#include "shadow.h"

uniform float3	view_shadow_proj;

//	Cascade cross-fade -- see accum_sun_cascade.ps. The last cascade takes everything the tighter ones
//	left over: (1-a_prev)*(1-a_prev2). Both are needed, not just the immediate predecessor -- the
//	cascade boxes are slid forward along the view and are NOT nested, so cascade 0 sticks out of
//	cascade 1 behind the player, and dropping its term there hands out the sunlight twice.
uniform float4x4	m_shadow_prev;		//	same as m_shadow, for the previous cascade
uniform float4x4	m_shadow_prev2;		//	 ... and for the one before that
uniform float4		cascade_blend;		//	x: own fade, y: previous cascade's, z: has previous,
										//	w: fade of the cascade before that, 0 if there is none

float cascade_weight( float4 PS, float fade )
{
	float3	p	= PS.xyz/PS.w;
	float2	d	= 0.5f - abs( p.xy - 0.5f );
	float2	f	= saturate( d/fade );
	return	min( f.x, f.y ) * step( 0.7f, p.z ) * step( p.z, 1.f );
}

float4 	main		( float4 tc : TEXCOORD0, float4 tcJ : TEXCOORD1 ) : COLOR
{
  float4 _P		= tex2Dproj 	(s_position, 	tc);
  float4  _N		= tex2Dproj 	(s_normal,   	tc);

  	float4 	P4 	= float4	(_P.x,_P.y,_P.z,1.f);
	float4 	PS	= mul		(m_shadow, 	P4);

	// ----- cascade weight (before anything expensive: the tighter cascades own the near pixels)
	float	w	= 1.f - cascade_weight( mul( m_shadow_prev, P4 ), cascade_blend.y );
	if ( cascade_blend.w > 0.f )
			w  *= 1.f - cascade_weight( mul( m_shadow_prev2, P4 ), cascade_blend.w );
	clip( w - 0.001f );

	// ----- light-model
	float 	m	= xmaterial	;
# ifndef USE_R2_STATIC_SUN
			m 	= _P.w		;
# endif
	float4	light 	= plight_infinity (m,_P,_N,Ldynamic_dir);

	// ----- shadow
	float 	s 	= sunmask	(P4);
	#if SUN_QUALITY==2
	  s 	*= shadowtest_sun 	(PS,float4(0,0,0,0));
	#else
	  s 	*= shadow		(PS);
	#endif
	
	// Fading code
	float2 	tc_f	= (PS.xy/PS.w)-float2(0.5f,0.5f);
			// Fade only fron edges
			// tc_f 	*= step( -dot( tc_f, view_shadow_proj.xy ), 0 );
			tc_f	= abs( tc_f );
	float 	border 	= 0.4f;
	float 	fac_x 	= 1.f-saturate( ( tc_f.x - border )/(0.5f-border));
	float 	fac_y 	= 1.f-saturate( ( tc_f.y - border )/(0.5f-border));
	
	s += ((1-s)*(1-fac_x*fac_y));
	//\ // Fading code

	return 		blend		(Ldynamic_color * light * s * w,tc);
}
