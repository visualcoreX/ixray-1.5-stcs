/*
------------------------------------------------------------------
SMAA edge detection, pixel -- DX9 (SMAA_HLSL_3)
------------------------------------------------------------------
References:
https://github.com/iryoku/smaa
------------------------------------------------------------------
*/

#include "common.h"

#define SMAA_HLSL_3
#define SMAA_PRESET_ULTRA
#define SMAA_INCLUDE_VS 0
#define SMAA_INCLUDE_PS 1

uniform float4 screen_res;			// x=width, y=height, z=1/width, w=1/height
#define SMAA_RT_METRICS screen_res.zwxy

#include "smaa.h"

uniform sampler2D	s_smaa_image;

struct v2p_smaa
{
	float2	tc0			: TEXCOORD0;
	float4	offset[3]	: TEXCOORD1;
	float4	HPos		: POSITION;
};

float4 main(v2p_smaa I) : COLOR
{
	// Colour detection, like R3. It costs more than the luma one but catches edges between two
	// colours of equal brightness, which the deferred picture has plenty of. Pixels with no edge
	// at all are discarded inside, so the target has to be cleared before this runs.
	return float4(SMAAColorEdgeDetectionPS(I.tc0, I.offset, s_smaa_image), 0.0f, 0.0f);
}
