#include "common.h"

struct 	v2p
{
 	float2 	tc0	: 	TEXCOORD0;	// base
	float4	c	:	COLOR0;		// diffuse

#ifdef	USE_SOFT_PARTICLES
//	Igor: for additional depth dest
	float4 tctexgen	: TEXCOORD1;
#endif	//	USE_SOFT_PARTICLES
    float fog : FOG;
};

// No soft fade here (the soft-particle texgen still comes in, as particle.vs puts it out). The glow --
// sparks, flashes, fire -- is small and lives right at the surfaces: a hit's sparks (hit_fx), a muzzle
// flash at a wall. The fade, ~0.8 m to come in full, ate it there; clipped by the geometry it reads right.
// The smoke (particles\blend, particle.ps) keeps it.

float4 main(v2p I) : COLOR
{
	float4 result = I.c * tex2D	(s_base,I.tc0);

	clip(result.a - (0.01f / 255.0f));
    result.w *= I.fog;
    result.xyz *= I.fog;

	return	result;
}
