-- EM1 (wpn_gauss_aes) small talk: traders and mechanics who have never seen the rifle.
-- Offered only while the rifle is on the actor, and once per NPC: the answer stores
-- em1_asked_<tag> = true in the actor's pstor, which rides the save.
-- The Marsh mechanic is not here: he has the real line (mar_gauss_ammo.script).

local EM1_SECT = "wpn_gauss_aes"

local function has_em1()
	return db.actor:object(EM1_SECT) ~= nil
end

local function asked(tag)
	return xr_logic.pstor_retrieve(db.actor, "em1_asked_" .. tag, false) == true
end

local function mark(tag)
	xr_logic.pstor_store(db.actor, "em1_asked_" .. tag, true)
end

function can_esc_tech(first_speaker, second_speaker)	return has_em1() and not asked("esc_tech")	end
function done_esc_tech(first_speaker, second_speaker)	mark("esc_tech")	end
function can_agr_mech(first_speaker, second_speaker)	return has_em1() and not asked("agr_mech")	end
function done_agr_mech(first_speaker, second_speaker)	mark("agr_mech")	end
