-- Marsh, Clear Sky mechanic (mar_csky_tech): the Gauss line.
--   conversion  the player brings wpn_gauss_aes (EM1 experimental rifle) -> a day later a regular wpn_gauss
--   ammo intro  after the conversion: "where do I get ammo" -> home-made cells for 10000, upgrade warning
--   order       10000 -> two game hours -> 30 ammo_gauss_cardan (repeatable)
-- State lives in the actor's pstor, so it rides the save:
--   mar_gauss_conv     0 = nothing, 1 = EM1 at the mechanic, 2 = converted
--   mar_gauss_conv_t0  game seconds when the conversion started
--   mar_gauss_stage    2 = cells unlocked (1 = legacy research state from the first version)
--   mar_gauss_rifle    legacy: id of a rifle handed over for research, -1 = none
--   mar_gauss_order    true while an order is being made
--   mar_gauss_t0       game seconds when the order was paid

local PRICE      = 10000
local ORDER_SEC  = 2 * 60 * 60                 -- two game hours
local CONV_SEC   = 24 * 60 * 60                -- a game day
local AMMO_SECT  = "ammo_gauss_cardan"
local AMMO_BOXES = 5                           -- box_size 6 -> 30 rounds
local EM1_SECT   = "wpn_gauss_aes"
local GAUSS_SECT = "wpn_gauss"

local function get(key, def)	return xr_logic.pstor_retrieve(db.actor, key, def)	end
local function put(key, val)	xr_logic.pstor_store(db.actor, key, val)			end

-- Game time as a plain number of seconds: pstor saves numbers, not CTime. Counted from a fixed date well
-- before the game's calendar, so it stays far below 2^31 and is saved as an exact s32.
local epoch = nil
local function now_sec()
	if epoch == nil then
		epoch = game.CTime()
		epoch:set(2000, 1, 1, 0, 0, 0, 0)
	end
	return math.floor(game.get_game_time():diffSec(epoch))
end

local function waited(key, sec)
	return now_sec() - get(key, 0) >= sec
end

-- conversion ----------------------------------------------------------------------------------------
function conv_can_ask(first_speaker, second_speaker)
	return get("mar_gauss_conv", 0) == 0 and db.actor:object(EM1_SECT) ~= nil
end

function conv_give(first_speaker, second_speaker)
	local em1 = db.actor:object(EM1_SECT)
	if em1 == nil then return end
	-- rounds still in the magazine go back to the actor instead of disappearing with the prototype.
	-- create_ammo refuses more than one box at a time (THROW on box_size), so hand them out box by box.
	local rounds = em1:get_ammo_in_magazine()
	if rounds > 0 then
		local ini       = system_ini()
		local ammo_sect = string.match(ini:r_string(EM1_SECT, "ammo_class"), "([^,%s]+)")
		local box       = ini:r_s32(ammo_sect, "box_size")
		local left      = rounds
		while left > 0 do
			local n = math.min(left, box)
			alife():create_ammo(ammo_sect, vector(), 0, 0, 0, n)		-- 0 = actor
			left = left - n
		end
		news_manager.relocate_item(db.actor, "in", ammo_sect, rounds)
	end
	local se = alife():object(em1:id())
	if se ~= nil then alife():release(se, true) end
	news_manager.relocate_item(db.actor, "out", EM1_SECT, 1)
	put("mar_gauss_conv", 1)
	put("mar_gauss_conv_t0", now_sec())
end

function conv_waiting(first_speaker, second_speaker)
	return get("mar_gauss_conv", 0) == 1 and not waited("mar_gauss_conv_t0", CONV_SEC)
end

function conv_ready(first_speaker, second_speaker)
	return get("mar_gauss_conv", 0) == 1 and waited("mar_gauss_conv_t0", CONV_SEC)
end

function conv_finish(first_speaker, second_speaker)
	put("mar_gauss_conv", 2)
	alife():create(GAUSS_SECT, vector(), 0, 0, 0)		-- 0 = actor
	news_manager.relocate_item(db.actor, "in", GAUSS_SECT, 1)
end

-- ammo intro ----------------------------------------------------------------------------------------
function ammo_can_intro(first_speaker, second_speaker)
	return get("mar_gauss_conv", 0) == 2 and get("mar_gauss_stage", 0) ~= 2
end

function ammo_intro(first_speaker, second_speaker)
	put("mar_gauss_stage", 2)
	-- legacy (first version): a rifle handed over for research is still at the mechanic -> give it back
	local id = get("mar_gauss_rifle", -1)
	if id >= 0 then
		local npc   = dialogs.who_is_npc(first_speaker, second_speaker)
		local rifle = level.object_by_id(id)
		if rifle ~= nil and rifle:parent() ~= nil and rifle:parent():id() == npc:id() then
			npc:transfer_item(rifle, db.actor)
			news_manager.relocate_item(db.actor, "in", rifle:section(), 1)
		end
		put("mar_gauss_rifle", -1)
	end
end

-- order ---------------------------------------------------------------------------------------------
function can_order(first_speaker, second_speaker)
	return get("mar_gauss_stage", 0) == 2 and get("mar_gauss_order", false) ~= true
end

-- the two mutually exclusive "pay" / "no money" answers
function has_money(first_speaker, second_speaker)
	return db.actor:money() >= PRICE
end

function no_money(first_speaker, second_speaker)
	return db.actor:money() < PRICE
end

function pay(first_speaker, second_speaker)
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	if db.actor:money() < PRICE then return end
	dialogs.relocate_money(npc, PRICE, "out")
	put("mar_gauss_order", true)
	put("mar_gauss_t0", now_sec())
end

function order_waiting(first_speaker, second_speaker)
	return get("mar_gauss_stage", 0) == 2 and get("mar_gauss_order", false) == true and not waited("mar_gauss_t0", ORDER_SEC)
end

function order_ready(first_speaker, second_speaker)
	return get("mar_gauss_stage", 0) == 2 and get("mar_gauss_order", false) == true and waited("mar_gauss_t0", ORDER_SEC)
end

function give_ammo(first_speaker, second_speaker)
	put("mar_gauss_order", false)
	local vec = vector()
	for i = 1, AMMO_BOXES do
		alife():create(AMMO_SECT, vec, 0, 0, 0)		-- 0 = actor
	end
	news_manager.relocate_item(db.actor, "in", AMMO_SECT, AMMO_BOXES * system_ini():r_s32(AMMO_SECT, "box_size"))
end
