# Global ignoring of different binaries and another temporary files

# Visual Studio user settings
*.suo
*.user

# Visual C++ cache files
.vs/
ipch/
*.ncb
*.opendb
*.sdf
*.opensdf
*.VC.db
*.VC.VC.opendb
*.aps

# Build results
obj/
lib/
bin/

# Migrating report files
_UpgradeReport_Files/
UpgradeLog*.XML
UpgradeLog*.htm

# Dependencies
packages/

# C++ Builder backups
*.~bpg
*.~bpr
*.~h
*.~cpp

# X-Ray resources
*.db*

# X-Ray user files
_appdata_/

# Temporary files
temp/
gamedata_origin/
patch/
*.log

# Python bytecode from the tools
__pycache__/
*.pyc

# Compiled shader cache some engines write next to the sources; the game reads gamedata/shaders
# through a junction, so keep any such cache out of the repo
gamedata/shaders/*/objects/
